#!/usr/bin/env bash
# Scaffold the contract a minion is briefed with, at $SIANA_HOME/briefs/<task-id>.md.
#
# The task record already carries what a script can check: the project, the working
# directory, the verify command, the pointers to read. What it cannot carry is what
# the work actually is, what "done" looks like beyond an exit code, and what is
# deliberately not being asked for. That is this file, and SIANA writes it by hand
# because it is judgment.
#
# The mechanics are here instead: pick the right contract for the delivery kind,
# refuse a task that does not exist, and never clobber a brief that already does.
#
# Usage: siana-brief <task-id> --ship --type <type> [--repairs <ship-task>] | --scout
#
#   --ship     the work lands. The minion commits on `siana/<type>/<task-id>` and the
#              branch is the deliverable; SIANA lands it.
#   --scout    the work reports. The minion writes $SIANA_HOME/reports/<task-id>.md
#              and lands nothing; its worktree is scratch.
#   --type     the Conventional Commit type a ship task's commits will carry, and the
#              middle segment of its branch. Required for --ship, refused for --scout.
#   --repairs  this ship task repairs work that is already published, named by the
#              ship task that published it. Ship work only, and `--type fix`.
#
# A repair keeps a branch and a QA task of its own, because a minion may not work in
# a tree a live run is reading. What changes is where it lands: the brief records the
# branch the repaired work was published from, and `siana-publish` fast-forwards that
# branch to the head QA accepts instead of opening a second request holding the same
# commits. That record is stated here and never inferred later, because every fix is
# cut from the branch it repairs, so ancestry says nothing about which of them is
# one.
#
# The type is stated here and nowhere else. Nothing downstream reads it back off a
# title, a diff, a commit or a minion's report, because by then it would be a guess
# about what the work turned out to be rather than a statement of what it is for.
# This writes the branch that follows from it into the brief, and every command that
# needs to know where the work lives reads that one line.
#
# A ship task in a project whose registry record carries a `qa` command is paired
# here with a QA task of its own: it depends on the ship task, so the queue makes
# it ready the moment that work comes back, and its `base` is that same branch,
# so its minion is put on the branch it was queued to judge. The pairing happens
# here because this is the only place a task's delivery kind is ever stated, and a
# QA task nobody remembered to queue is exactly the false-green that registry
# field was set to prevent. Skipping QA for one task is `tasks drop <qa-id>`,
# which is a decision the queue records.
#
# The kind is never defaulted. Ship work and scout work are not allowed to blur into
# each other on their own, and a default is how they would.
#
# The brief is found by convention, not by wiring: a minion is told where its own
# brief lives, and treats a missing one as a `block`. So the brief is written after
# `tasks add` has chosen the id, and no pointer has to be threaded anywhere.
set -euo pipefail

usage() {
    awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

die() {
    echo "error: $1" >&2
    shift
    for hint in "$@"; do echo "  $hint" >&2; done
    exit 1
}

# The project's QA command, read from the registry itself rather than parsed out of
# `tasks show`. A command carrying a quote or a colon comes back from TOON escaped,
# and a QA task whose verify was mangled on the way in is a check that fails for a
# reason nobody wrote. The log is folded the way every other reader folds it: the
# last write for a handle wins, and a tombstone is an absence.
#
# It prints `none`, or `qa` followed by the project's path and its command.
registry_qa() {
    python3 - "$home/projects.jsonl" "$1" <<'PYEOF'
import json, os, sys

store, handle = sys.argv[1], sys.argv[2]
projects = {}
if os.path.isfile(store):
    with open(store) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rec = json.loads(line)
            except json.JSONDecodeError:
                sys.exit(f"error: {store} holds a line that is not a record")
            seen = rec.get("handle")
            if seen is None:
                continue
            if rec.get("_deleted"):
                projects.pop(seen, None)
            else:
                projects[seen] = rec

if handle not in projects:
    sys.exit(f"error: unknown project: {handle}\n"
             "  the task names it and the registry does not have it, so dispatch\n"
             "  will refuse this task for the same reason")
qa = projects[handle].get("qa")
if not qa:
    print("none")
    raise SystemExit(0)
if not projects[handle].get("worktree", True):
    sys.exit(f"error: {handle} asks for QA, and git cannot branch it\n"
             "  a QA minion judges the ship task's branch from a worktree of its\n"
             "  own, and this project is recorded as having neither\n"
             "  either make it a git repository, or clear `qa` on it and accept that\n"
             "  ship work there lands on the word of the minion that did it")

path = projects[handle]["path"]
# Both travel back a line at a time, so a newline in either would silently cut one
# of them in half and leave a QA task verifying something nobody wrote.
for name, value in (("path", path), ("qa command", qa)):
    if "\n" in value:
        sys.exit(f"error: the {name} for {handle} spans more than one line\n"
                 "  it has to survive as one line to reach the QA task intact")
print("qa")
print(path)
print(qa)
PYEOF
}

# Where a repair lands, read out of the brief of the work it repairs. Two lines: the
# branch that task's own work lives on, which is what a repair has to be cut from,
# and the branch its work is published from, which is where an accepted repair goes.
# The two are the same until the work being repaired is itself a repair.
#
# The reader below is `siana-publish`'s, verbatim, and `tests/test_ship_branch.py`
# compares the copies as text. Duplicated rather than imported because these are
# commands and not a package, so there is nowhere for one copy to live: what a writer
# has to agree with is the command that reads the record back, and a record written
# against a branch that command does not answer is a repair nobody can publish.
repair_branches() {
    python3 - "$home" "$1" <<'PYEOF'
import os
import re
import sys


def die(message, *hints):
    print(f"error: {message}", file=sys.stderr)
    for hint in hints:
        print(f"  {hint}", file=sys.stderr)
    raise SystemExit(1)


# The one line in a ship brief that a script reads. Indented and a single token, so
# prose about the branch cannot be mistaken for the record of it.
BRANCH_LINE = re.compile(r"^[ \t]+branch[ \t]+(\S+)[ \t]*$", re.M)

# Only a ship brief names a ship branch. A QA brief carries the branch it judges in
# the same shape, and reading that as the QA task's own would put its minion on the
# branch it was meant to be cut from rather than beside it.
SHIP_SECTION = re.compile(r"^## Delivery: ship[ \t]*$(.*?)(?=^## |\Z)", re.M | re.S)

# `siana/<task-id>`, or `siana/<type>/<task-id>`. Shape only: which types are allowed
# is `siana-brief`'s to say, because that is the one place a type is ever stated, and
# a second opinion here would be a second place to change when that list moves.
BRANCH_NAME = re.compile(r"siana/[a-z0-9][a-z0-9_-]*(?:/[a-z0-9][a-z0-9_-]*)?")


def ship_branch(home: str, task_id: str) -> str:
    """The branch this task's work lives on.

    Ship work is briefed with an explicit Conventional Commit type, and `siana-brief`
    writes the `siana/<type>/<task-id>` that follows from it into the brief's own
    delivery section. That line is the fleet's only record of the type, because the
    type is stated and never inferred: rebuilding a branch name here out of a title,
    a diff or a commit is the guess the whole convention exists to prevent.

    A brief that names no branch answers `siana/<task-id>`. That covers scout and QA
    work, whose branch names are fleet roles rather than commit types, and every task
    briefed before this existed, so nothing already in flight has to be migrated to
    stay dispatchable.

    A line this cannot read refuses instead of falling back. Every caller is asking
    which branch holds the work, and answering `siana/<task-id>` when the brief says
    otherwise would put a worktree, a review or a publish on a branch nobody named.
    """
    path = os.path.join(home, "briefs", f"{task_id}.md")
    try:
        with open(path) as fh:
            section = SHIP_SECTION.search(fh.read())
    except OSError:
        return f"siana/{task_id}"
    named = sorted(set(BRANCH_LINE.findall(section.group(1)))) if section else []
    if not named:
        return f"siana/{task_id}"
    if len(named) > 1:
        die(f"{path} names more than one branch: {', '.join(named)}",
            "a brief records exactly one, and which of them holds the work is not",
            "something a script may choose between; fix the brief")
    if not BRANCH_NAME.fullmatch(named[0]):
        die(f"{path} records the branch as {named[0]!r}",
            "a fleet branch is `siana/<type>/<task-id>` for ship work and",
            "`siana/<task-id>` otherwise; nothing here may guess at what was meant")
    return named[0]


# The second line a repair's ship brief records, beside the branch. It names the ship
# task whose published work this repairs, and the branch that work was published
# from, in that order and on one line, so an accepted repair lands on the request
# that is already open instead of opening a second one for the same work.
REPAIR_LINE = re.compile(r"^[ \t]+repairs[ \t]+(\S+)[ \t]+(\S+)[ \t]*$", re.M)

# Anything indented that even claims to be that record. What it catches is a record
# the strict line cannot read: half of it, three of it, a name wearing a space. Read
# as no record at all, such a brief publishes a second request for work that already
# has one, which is the exact failure the record exists to prevent, so it stops here
# instead.
REPAIR_CLAIM = re.compile(r"^[ \t]+repairs\b.*$", re.M)

# A task id as the store's own contract writes one. Compared rather than trusted: a
# record naming something else is a record nothing can look up.
TASK_ID = re.compile(r"[a-z][a-z0-9-]*")


def repair_record(home: str, task_id: str):
    """The ship task this task repairs and the branch that work was published from,
    or None when this is ordinary ship work.

    Stated by SIANA at briefing time and never inferred here. A repair is not
    readable off prose, a title, a commit message, ancestry, or the forge: a branch
    cut from another one is the ordinary shape of every fix, and a request that
    happens to be open over there is not evidence that this work belongs on it.

    Every unreadable shape refuses rather than answering None. None means ordinary
    ship work, which opens a request of its own, so answering it about a brief that
    says `repairs` is how the duplicate this record exists to prevent gets opened."""
    path = os.path.join(home, "briefs", f"{task_id}.md")
    try:
        with open(path) as fh:
            section = SHIP_SECTION.search(fh.read())
    except OSError:
        return None
    if section is None:
        return None
    claimed = REPAIR_CLAIM.findall(section.group(1))
    if not claimed:
        return None
    named = REPAIR_LINE.findall(section.group(1))
    if len(claimed) > 1 or len(named) != 1:
        die(f"{path} does not record exactly one repair",
            *[f"  {line.strip()}" for line in claimed],
            "a repair record is one line of `repairs <ship-task> <branch>`, and",
            "which request an accepted repair lands on is not something a script",
            "may choose between; fix the brief")
    target, branch = named[0]
    if not TASK_ID.fullmatch(target) or not BRANCH_NAME.fullmatch(branch):
        die(f"{path} records the repair as {target!r} {branch!r}",
            "it names the ship task whose work this repairs and the branch that",
            "work was published from; nothing here may guess at what was meant")
    return target, branch


def publication_branch(home: str, task_id: str) -> str:
    """The branch whose merge request this task's work is published on.

    Its own branch, unless it is itself a repair: a repair of a repair belongs on the
    same request as the work it descends from, and the record carries that branch
    already, so the chain is one hop long however many repairs deep the work is."""
    record = repair_record(home, task_id)
    return record[1] if record else ship_branch(home, task_id)


print(ship_branch(sys.argv[1], sys.argv[2]))
print(publication_branch(sys.argv[1], sys.argv[2]))
PYEOF
}

# The eleven Conventional Commit types, and the whole of what may stand between
# `siana/` and a task id. A branch named for anything else announces a commit its
# project's CI will reject, so the list is checked here rather than trusted.
TYPES="build chore ci docs feat fix perf refactor revert style test"

id=""
kind=""
type=""
repairs=""
while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help) usage; exit 0 ;;
        --ship)  [ -z "$kind" ] || die "--ship and --scout are the two kinds; pick one"
                 kind=ship ;;
        --scout) [ -z "$kind" ] || die "--ship and --scout are the two kinds; pick one"
                 kind=scout ;;
        --type)  [ $# -ge 2 ] || die "--type needs a Conventional Commit type" \
                     "one of: $TYPES"
                 [ -z "$type" ] || die "one type at a time; got '$type' and '$2'"
                 type="$2"; shift ;;
        # Accepted as well as the spaced form, because the near miss is otherwise an
        # `unknown option` that says nothing about the type being the problem, and a
        # retype here costs SIANA a whole turn.
        --type=*) [ -z "$type" ] || die "one type at a time; got '$type' and '${1#--type=}'"
                 type="${1#--type=}" ;;
        --repairs) [ $# -ge 2 ] || die "--repairs needs the ship task whose published" \
                       "work this repairs"
                 [ -z "$repairs" ] || die "one repair target at a time; got" \
                     "'$repairs' and '$2'"
                 repairs="$2"; shift ;;
        --repairs=*) [ -z "$repairs" ] || die "one repair target at a time; got" \
                     "'$repairs' and '${1#--repairs=}'"
                 repairs="${1#--repairs=}" ;;
        -*) die "unknown option: $1" "run \`siana-brief --help\`" ;;
        *)  [ -z "$id" ] || die "one task at a time; got '$id' and '$1'"
            id="$1" ;;
    esac
    shift
done

[ -n "$id" ] || die "which task?" \
    "usage: siana-brief <task-id> --ship --type <type> | --scout"
[ -n "$kind" ] || die "$id needs a delivery kind: --ship or --scout" \
    "ship work lands through the project's rigor; scout work leaves a report" \
    "and lands nothing. Neither is inferred, because a wrong guess here is a" \
    "minion shipping what was only meant to be investigated"

# Argument checks before anything is resolved or written, so a missing or misspelt
# type costs a retype and never a half-scaffolded task: a brief this refuses to
# rewrite, or a QA task queued against a branch no minion will be put on.
branch=""
if [ "$kind" = ship ]; then
    [ -n "$type" ] || die "$id needs a commit type: --type <type>" \
        "a ship branch is siana/<type>/<task-id>, and the type says which of the" \
        "eleven Conventional Commit categories the work lands under" \
        "you state it here, because everything downstream would be reading it back" \
        "off a title or a diff, which is a guess about what the work turned out to" \
        "be rather than a statement of what it is for" \
        "one of: $TYPES"
    # Compared whole against one type at a time. The membership test this replaces,
    # `case " $TYPES " in *" $type "*)`, matched any adjacent run of the list -
    # `--type 'ci docs'` is a substring of the haystack, bounded by spaces on both
    # sides - and went on to write `siana/ci docs/<id>`: a name git refuses to create
    # and that no reader can read back, because the branch line holds one \S+ token.
    # Every command then fell to the legacy `siana/<id>` while the QA task queued
    # just below waited on a base nobody had ever made, and the first refusal came
    # from a QA dispatch long after the ship work was finished.
    supported=""
    for known in $TYPES; do
        if [ "$type" = "$known" ]; then supported=yes; break; fi
    done
    [ -n "$supported" ] || die "$type is not a Conventional Commit type" \
        "the eleven are: $TYPES" \
        "a branch named for anything else announces a commit that this" \
        "project's CI rejects on the merge request"
    branch="siana/$type/$id"
    # A repair is a fix by definition, and the branch it lands on already carries the
    # feature it repairs. Any other type here would announce a commit that disagrees
    # with the branch it sits on, on somebody else's merge request.
    if [ -n "$repairs" ] && [ "$type" != fix ]; then
        die "$id repairs $repairs, and repairs are briefed --type fix" \
            "got --type $type" \
            "a repair adds no category of its own: what it lands on is the request" \
            "the work it repairs was published on, and that request is already" \
            "whatever the work it holds is"
    fi
    [ "$repairs" != "$id" ] || die "$id cannot repair itself" \
        "--repairs names the ship task whose published work this repairs, and a" \
        "task that named itself would record a branch that publishes nothing"
elif [ -n "$type" ]; then
    die "--type is for ship work, and $id was briefed --scout" \
        "a scout lands nothing, so there is no commit for a type to describe" \
        "its branch is siana/<task-id>, which is a role in this fleet rather than" \
        "a category of change"
elif [ -n "$repairs" ]; then
    die "--repairs is for ship work, and $id was briefed --scout" \
        "a repair lands on the merge request the work it repairs was published on," \
        "and a scout lands nothing at all"
fi

home="${SIANA_HOME:-$HOME/.siana}"
tasks_file="${SIANA_TASKS_FILE:-$home/tasks.jsonl}"
template="$home/brief-$kind.md"
brief="$home/briefs/$id.md"

[ -f "$template" ] || die "no $kind brief template at $template" \
    "SIANA owns its home copy and can evolve it" \
    "run \`just init\` in the distro to lay one down"

# Ask the queue rather than reading the store here: a second reader is a second
# chance to disagree with the first. A typo in the id has to stop at this line,
# because a brief filed under a name no task carries is a brief no minion ever sees.
if ! show="$(tasks --file "$tasks_file" show "$id" 2>&1)"; then
    die "no such task: $id" "$(printf '%s' "$show" | head -1)" \
        "run \`tasks --file $tasks_file list\` to see the queue"
fi

[ -e "$brief" ] && die "$id is already briefed at $brief" \
    "a brief is rewritten by editing it, never by scaffolding over it:" \
    "a minion may already have read this one"

# Resolved before anything is written. A registry that cannot answer has to stop
# the whole scaffolding, rather than leave a briefed ship task standing in a project
# whose captain asked for QA behind every one of them.
handle=""; qa_path=""; qa_cmd=""
if [ "$kind" = ship ]; then
    # The handle is the one field safe to read out of TOON: its contract is a
    # pattern with no character TOON would quote or escape.
    handle="$(printf '%s\n' "$show" | sed -n 's/^  project: //p')"
    if [ -z "$handle" ] || [ "$handle" = null ]; then
        echo "warning: $id names no project, so nothing here can say whether it needs" >&2
        echo "         QA; dispatch refuses it until it has one either way" >&2
    else
        info="$(registry_qa "$handle")" || exit 1
        if [ "$(printf '%s\n' "$info" | sed -n 1p)" = qa ]; then
            qa_path="$(printf '%s\n' "$info" | sed -n 2p)"
            qa_cmd="$(printf '%s\n' "$info" | sed -n 3p)"
            [ -f "$home/brief-qa.md" ] || die "no qa brief template at $home/brief-qa.md" \
                "$handle asks for QA behind every ship task, and a QA minion with no" \
                "contract would judge the work by its own lights instead of its brief" \
                "run \`just init\` in the distro to lay one down"
        fi
    fi
fi

# Where an accepted repair lands, resolved before anything is written. Both branches
# come from the repaired task's own brief rather than from its id: a repair of a
# repair belongs on the same request as the work underneath it, and the record on the
# middle brief is the only thing that says which request that is.
publication=""
if [ -n "$repairs" ]; then
    if ! repaired_show="$(tasks --file "$tasks_file" show "$repairs" 2>&1)"; then
        die "no such task to repair: $repairs" \
            "$(printf '%s' "$repaired_show" | head -1)" \
            "--repairs names the ship task whose published work this repairs, and a" \
            "task the queue does not have published nothing"
    fi
    [ -f "$home/briefs/$repairs.md" ] || \
        die "no brief at $home/briefs/$repairs.md" \
            "it is where the branch that work was published from is recorded, and" \
            "the fallback for a task with no brief is a name only legacy work has" \
            "a repair recorded against a branch nobody published is a repair that" \
            "cannot land, and it would open the second request this exists to stop"
    resolved="$(repair_branches "$repairs")" || exit 1
    repaired_branch="$(printf '%s\n' "$resolved" | sed -n 1p)"
    publication="$(printf '%s\n' "$resolved" | sed -n 2p)"

    # The base is what makes this a repair of that work rather than a second attempt
    # at it. A minion cut from anywhere else starts without the commits it is meant
    # to be fixing, and its accepted head would not be a fast-forward of the branch
    # this records - which publication refuses, after the work is done.
    base="$(printf '%s\n' "$show" | sed -n 's/^  base: //p')"
    [ "$base" = null ] && base=""
    if [ "$base" != "$repaired_branch" ]; then
        die "$id was cut from ${base:-nothing}, and $repairs built $repaired_branch" \
            "a repair starts from the work it repairs, so that branch is its base" \
            "queue it again with \`--base $repaired_branch\`, or name the task this" \
            "work actually repairs"
    fi
fi

mkdir -p "$home/briefs"
# The branch is substituted rather than left as a placeholder for SIANA to fill. It
# is the one thing in a brief a script derives rather than judges, and a name typed
# twice is a name that can disagree with itself; every command downstream reads this
# line, so the copy in the brief is the only record there is.
#
# `{REPAIR}` is a line of its own, and it is either the repair record or nothing: an
# ordinary ship brief has no such line at all, so nothing downstream has to tell an
# empty record from an absent one. The marker is this command's, so a template
# carrying it inside a sentence loses that sentence rather than half a record.
if [ -n "$publication" ]; then
    sed -e "s|{SHIP_BRANCH}|$branch|g" \
        -e "s|{REPAIR}|    repairs $repairs $publication|" "$template" > "$brief"
else
    sed -e "s|{SHIP_BRANCH}|$branch|g" -e "/{REPAIR}/d" "$template" > "$brief"
fi

# The substitution is checked, not assumed. Every command reads the branch back out
# of this file the same way: an indented `branch <name>` line, inside the brief's own
# `## Delivery: ship` section and nowhere else. The home's copy of this template is
# the captain's to evolve, and `just init` keeps a diverged one on purpose, so a
# template that has lost the marker, carries it in a sentence, or has moved it under
# a heading of its own writes a brief the readers find no branch in. The QA task
# queued below would then be cut from siana/<type>/<id> while every reader answered
# siana/<id>, and that split stays invisible until a QA dispatch fails on a base
# nobody ever created, long after the ship work is finished.
#
# So what is checked is the section the readers read, and not the file: a check with
# a wider reach than theirs passes exactly where they would have found nothing.
delivery_section() {
    awk '/^## / { taking = ($0 ~ /^## Delivery: ship[[:space:]]*$/); next } taking' "$1"
}

if [ -n "$branch" ] && ! delivery_section "$brief" |
        grep -q "^[[:space:]]\{1,\}branch[[:space:]]\{1,\}$branch[[:space:]]*$"; then
    rm -f "$brief"
    die "$template does not record the branch where every command looks for it" \
        "$id would be briefed with no branch in it, and every command would read" \
        "siana/$id while the QA task behind it judged $branch" \
        "the '## Delivery: ship' section needs an indented line of exactly:" \
        "    branch  {SHIP_BRANCH}" \
        "under any other heading it is prose, and no command reads it" \
        "nothing has been written and nothing has been queued"
fi

# The repair record is checked the same way and for the same reason, with one thing
# added: it has to be there exactly once. A template that lost `{REPAIR}` writes a
# brief publication reads as ordinary ship work, and ordinary ship work opens a
# second merge request holding the same commits - which is the whole of what this
# record exists to prevent, arriving as a duplicate on the captain's forge rather
# than as an error here. One that carries the marker twice records the same repair
# twice, and `siana-publish` refuses a brief it cannot read one record out of.
if [ -n "$publication" ]; then
    keyword="^[[:space:]]\{1,\}repairs[[:space:]]\{1,\}"
    record="$keyword$repairs[[:space:]]\{1,\}$publication[[:space:]]*$"
    stated="$({ delivery_section "$brief" | grep -c "$keyword" || true; })"
    if [ "$stated" != 1 ] || ! delivery_section "$brief" | grep -q "$record"; then
        rm -f "$brief"
        die "$template does not record this repair where publication looks for it" \
            "$id would be briefed as ordinary ship work, and publishing it would" \
            "open a second merge request for what $publication already carries" \
            "the '## Delivery: ship' section needs the marker on a line of its own:" \
            "    {REPAIR}" \
            "exactly once, and under no other heading" \
            "nothing has been written and nothing has been queued"
    fi
fi

echo "briefed  $brief ($kind)"
[ -n "$branch" ] && echo "  branch $branch"
[ -n "$publication" ] && echo "  repairs $repairs, published from $publication"

# Filling this in is the whole point of scaffolding it, so say what is still empty.
# The minion refuses to work on an unfilled placeholder, which keeps a forgotten one
# from becoming a guess. A template the captain has evolved down to no markers at all
# is theirs to write that way, so grep finding none is an answer and not a failure:
# under `pipefail` its exit 1 would kill this script after the brief was copied.
placeholders="$({ grep -o '{[A-Z_]\+}' "$brief" || true; } | sort -u | tr '\n' ' ')"
[ -n "$placeholders" ] && echo "  fill   $placeholders"

# The QA task exists from the moment the ship task is briefed, and waits on it. The
# dependency is the whole trigger: the queue makes it ready when the work comes
# back, so nothing has to notice that a minion finished.
#
# Its verify is the project's QA command and the report together, so a QA `done` is
# evidence that the work was exercised here and that the finding survived the
# minion that found it. `--base` is how dispatch puts that minion on the branch it
# is judging rather than on a tree that never held the work.
if [ -n "$qa_cmd" ]; then
    verify='test -s "$SIANA_HOME/reports/$SIANA_TASK_ID.md" && '"$qa_cmd"
    if ! added="$(tasks --file "$tasks_file" add "QA $id" --project "$handle" \
            --cwd "$qa_path" --verify "$verify" --dep "$id" \
            --base "$branch" 2>&1)"; then
        die "$id is briefed, but the QA task behind it was not created" \
            "$(printf '%s' "$added" | head -1)" \
            "queue it by hand before dispatching $id, or dispatch knowing this" \
            "work will come back with nobody independent having looked at it"
    fi
    qa_id="$(printf '%s\n' "$added" | sed -n 's/^id: //p' | head -1)"
    [ -n "$qa_id" ] || die "the queue did not name the QA task it created for $id" \
        "run \`tasks --file $tasks_file list\` and finish the pairing by hand"
    # Nothing in a QA brief is SIANA's to fill: what the work was asked to do is
    # the ship task's own brief, and what to run is the project's QA command. That
    # is what makes QA cost nothing per task and therefore get used.
    sed -e "s|{SHIP_TASK}|$id|g" -e "s|{SHIP_BRANCH}|$branch|g" \
        "$home/brief-qa.md" > "$home/briefs/$qa_id.md"
    echo "paired   $home/briefs/$qa_id.md (qa $qa_id, waiting on $id)"
    echo "  runs   $qa_cmd"
fi

# A brief that arrives after dispatch is late, not wrong: the minion has already
# blocked on the missing one and can be pointed at this. Say so rather than refuse.
if printf '%s' "$show" | grep -q '^  status: doing$'; then
    echo "  late   $id is already dispatched; its minion started without this brief" >&2
    echo "         fill it, then tell that minion to read it" >&2
    # Its worktree was cut before this brief existed, so dispatch had no branch to
    # read and fell back to `siana/<task-id>`. Everything downstream now reads the
    # line written above instead, and the two disagree: the pipeline refuses that
    # worktree as being on the wrong branch, and it is right to. Said here because
    # this is the moment it becomes true, and nothing later can tell it happened.
    if [ -n "$branch" ]; then
        echo "         its worktree predates this brief, so it is on siana/$id and" >&2
        echo "         not $branch; that minion has to be re-dispatched, or this" >&2
        echo "         brief has to name the branch it is actually on" >&2
    fi
fi
