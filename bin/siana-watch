#!/usr/bin/env python3
"""Wake SIANA when a minion reports, so the fleet does not idle while nobody looks.

SIANA is turn-based. It cannot hold Herdr's event subscription open between turns,
so without this a minion that finishes is discovered whenever the captain next takes
a turn, and everything downstream of it waits that long for no reason.

This watches the queue, not the fleet. Herdr says a process stopped, never that it
succeeded, and its `idle` covers both a minion that finished and one that asked a
question in prose and stalled forever. The queue is the only report that counts, so
a terminal record appended to `tasks.jsonl` is the only thing that wakes anyone.

**The wake carries no content.** It says the queue moved and nothing else, because
anything it summarised would be a second source of truth able to disagree with the
store SIANA is about to read anyway. That is also why a missed wake costs only
timeliness: the store still holds everything, and the next wake or the next turn
recovers the whole picture. Never make this the report.

**Nothing here writes into SIANA's pane.** It used to, with herdr's `agent.prompt`,
and that wrote into the same input editor the captain types in: a draft sitting
there was concatenated with the wake and submitted as one user message under the
captain's own name. Herdr has no conditional write and no idea what is in that
editor, so no check before the write could ever have closed that race.

So this raises a counter at `$SIANA_HOME/wake/pending` and stops there. Delivery
belongs to a pi extension inside SIANA's own session, which can read the editor and
send in one synchronous block and therefore excludes the captain rather than racing
them. This is the only writer of `pending`; the extension is the only writer of
`consumed` and of the `consumer` record that says a session is reading them.

That extension exists for pi and there is no equivalent for claude, so a SIANA in
claude is refused at startup rather than served by the old path. Reinstating
`agent.prompt` as a fallback for it would quietly reinstate the bug this exists to
remove.

**Running this is the captain's autonomy grant.** SIANA reconciles and dispatches
ready work when woken, so while this runs the fleet advances without the captain in
the room. The grant is this process: it is given by starting it and withdrawn by
stopping it, and no flag and no registry field can confer it.

What outlives the process is a status record at `$SIANA_HOME/watch`, and it is only
ever evidence about a process. Nothing reads it as permission: `--status` asks the
operating system whether the recorded process is still here and still this command
before it calls anything running, so a record cannot hand a grant to a session the
captain did not choose to leave running. What it adds is a name for what stopped,
which a captain looking at a silent fleet cannot otherwise get.

Usage:
    siana-watch [--interval S]
    siana-watch --status

It runs until interrupted. SIANA's session is found through `$SIANA_HOME/session`,
written by `siana` at startup, so this must be started after SIANA is up.
"""

import argparse
import json
import os
import signal
import socket
import subprocess
import sys
import time

# What a minion writes and SIANA does not. SIANA calls add, start, dep, drop and
# reset, none of which land here, so this predicate isolates minion reports without
# guessing from owners. A `done` SIANA typed itself costs one wasted reconcile.
TERMINAL = {"done", "blocked"}

# How long SIANA may leave a raised wake untaken before this says so. It is a
# warning and never a deadline: the counter is durable, so a wake is held until it
# can be delivered however long that takes, and SIANA can be blocked waiting on the
# captain while the captain is away.
SETTLE_WARN_S = 300.0

# How long a pane may answer "no agent here" before this calls the session gone.
# Herdr loses its pane metadata across a server restart and re-detects each agent
# from the pane itself, so for a few seconds after a routine `herdr update` it
# truthfully reports no agent in a pane SIANA is alive and working in. Two minutes
# is far longer than that restart and re-detection take together, so anything still
# undetected at the end of it has really exited - and it is short enough that a
# session that did exit is said out loud long before the captain, seeing this process
# still running, has spent an afternoon believing the fleet was advancing.
DETECT_GRACE_S = 120.0


class Refusal(SystemExit):
    """A refusal that still knows what it said, matching siana-dispatch."""

    def __init__(self, lines):
        self.lines = lines
        super().__init__(1)

    def __str__(self):
        return "\n".join(self.lines)


class Unreachable(Refusal):
    """herdr itself never answered, which is a fact about herdr and about nothing
    else. A caller asking after a pane must not read it as an answer about that
    pane: reporting a live session as gone is how a captain is talked into
    abandoning one."""


def die(*lines, kind=Refusal):
    raise kind(list(lines))


class Herdr:
    """One request, one connection. Same protocol and timeout as siana-dispatch.

    The timeout is the point: a herdr that accepts the connection and then says
    nothing - wedged, stopped mid-request, or a listener bound by a server still
    starting - would otherwise park this process inside `recv` forever. A watcher
    parked there is the one thing this must never be, a process that looks like a
    live autonomy grant while it polls nothing and can wake nobody."""

    def __init__(self, path, timeout=30.0):
        self.path, self.timeout = os.path.expanduser(path), timeout

    def call(self, method, **params):
        # A socket this cannot even construct is herdr being unreachable like any
        # other: out of descriptors is exactly the state where a bare traceback
        # would end the watcher without telling the captain what to do about it.
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        except OSError as e:
            die(f"herdr is not reachable at {self.path}: {e}",
                "the session SIANA runs in lives in herdr; start it first",
                kind=Unreachable)
        # Held by the `with`, so a connect that fails still closes it. This is the
        # one path that repeats: while herdr is away, the loop reconnects every tick
        # for the whole detection grace, and a descriptor left for the garbage
        # collector on that path is the only place they accumulate.
        with sock as s:
            try:
                s.settimeout(self.timeout)
                s.connect(self.path)
            except OSError as e:
                die(f"herdr is not reachable at {self.path}: {e}",
                    "the session SIANA runs in lives in herdr; start it first",
                    kind=Unreachable)
            try:
                s.sendall((json.dumps({"id": "siana-watch", "method": method,
                                       "params": params}) + "\n").encode())
                buf = b""
                while not buf.endswith(b"\n"):
                    chunk = s.recv(65536)
                    if not chunk:
                        die(f"herdr closed the connection during {method}",
                            kind=Unreachable)
                    buf += chunk
            except OSError as e:
                die(f"herdr stopped answering during {method}: {e}",
                    "it accepted the connection and then said nothing, so nothing",
                    "here knows anything about SIANA's pane",
                    kind=Unreachable)
        reply = json.loads(buf)
        if "error" in reply:
            err = reply["error"]
            die(f"herdr refused {method}: {err.get('message', err)}")
        return reply.get("result", {})


def read_session(home):
    """SIANA's pane id and the harness in it.

    The pane is what liveness is asked about. Nothing is delivered through it any
    more, so it is not the wake path: it is the one handle by which this process can
    find out that the session it is the grant for has gone.

    Herdr's labels are not unique and its pane metadata is wiped when its server
    restarts, so this reads what `siana` recorded and never searches for an agent
    that looks about right. A stale file names a pane that is gone or now holds
    something else, and both are refusals rather than a watcher raising wakes for
    whatever happens to be there now.

    The harness travels with the pane for two reasons now. Herdr answers with the
    name of the agent it detected, so the liveness check has to know which name is
    SIANA's; and only `pi` has an extension that takes a wake, so it is also what
    says whether there is a delivery path at all. Recorded rather than inferred from
    the home: what is installed there is what SIANA could have started in, and this
    has to be what it did start in."""
    path = os.path.join(home, "session")
    if not os.path.isfile(path):
        die(f"no SIANA session recorded at {path}",
            "`siana` writes it at startup and removes it at exit, so SIANA is not",
            "running; start it first, then start this")
    fields = {}
    with open(path) as f:
        for line in f:
            if "=" in line:
                k, v = line.split("=", 1)
                fields[k.strip()] = v.strip()
    pane = fields.get("SIANA_PANE")
    # A session file written before SIANA could start in anything else. Its writer
    # started pi, so that is not a default standing in for an unknown - it is the
    # only thing the file could have meant.
    harness = fields.get("SIANA_HARNESS", "pi")
    if not pane:
        # A SIANA outside herdr is a working SIANA, just one this cannot watch for.
        # The wake itself would reach it perfectly well, because the extension reads
        # a file and does not care where its session runs. What is missing is the
        # other half: with no pane, nothing here can ever find out that the session
        # has exited, and a watcher still running after that is the captain's
        # autonomy grant outliving the thing it was given for.
        #
        # Saying which of the two it is beats reporting a missing session that is
        # sitting right there in front of the captain.
        die(f"SIANA (pid {fields.get('SIANA_PID', '?')}) is running outside herdr",
            "the wake would reach it, but with no pane nothing here can tell when",
            "that session has gone, and a watcher that outlives SIANA is a grant",
            "the captain never withdrew",
            "restart SIANA inside herdr if you want the fleet to advance while you",
            "are away")
    return pane, harness


# Where this process records that it is the grant. Not part of an install and never
# written by anything else: `siana-watch` is the only writer, and `--status` is the
# only reader that matters.
GRANT = "watch"

# The mailbox. One writer per file in each direction, which is why there is no write
# race here to reason about at all: this only ever writes `pending` and only ever
# reads `consumed` and `consumer`, and the pi extension only ever does the reverse.
# Neither ever truncates the other's file.
WAKE = "wake"
PENDING, CONSUMED, CONSUMER = "pending", "consumed", "consumer"

# The harness the wake extension exists for. A SIANA in the other one has no
# collision-free path to its session at all, so it is refused rather than served by
# the terminal write this was built to remove. `template/wake.ts` says why that
# write was the bug.
CONSUMING_HARNESS = "pi"


def wake_dir(home):
    return os.path.join(home, WAKE)


def stamp():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def process_command(pid):
    """What `ps` says that pid is running, or "" when it says nothing.

    Identity, not liveness. Pids are reused, so a live pid is not a live grant: the
    process wearing it has to still be the watcher that recorded it. `siana` asks
    the same question of its own session pid, and asks it the same way."""
    try:
        out = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                             capture_output=True, text=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return ""
    return out.stdout.strip()


def read_grant(path):
    """The recorded grant, or None when there is none.

    A record that will not parse refuses rather than reading as absent. "No watcher"
    and "a watcher whose record nobody can read" call for opposite things from the
    captain, and guessing the first would report an uncovered fleet that may be
    covered, or hand the record to a second watcher while the first still runs."""
    try:
        with open(path) as f:
            rec = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        die(f"the watcher status at {path} cannot be read: {e}",
            "nothing here can say whether the fleet is being watched; read that",
            "file, then remove it and start `siana-watch` again")
    if not isinstance(rec, dict) or rec.get("state") not in ("running", "failed"):
        die(f"the watcher status at {path} is not a record this wrote",
            f"it says its state is {(rec or {}).get('state')!r} if it says anything;",
            "read it, then remove it and start `siana-watch` again")
    return rec


def still_running(rec):
    """Whether that record's process is still the process that wrote it, and why not
    when it is not. Two questions and never one: the pid answers whether something is
    there, and the command answers whether it is the thing that recorded this.

    Asked of the watcher's own grant record and of the pi session's consumer record,
    which are written by different programs and are alike in the one way that
    matters: both name a pid and what `ps` called it, so neither can be stood in for
    by whatever lands on that pid next."""
    pid = rec.get("pid")
    if not isinstance(pid, int):
        return False, f"the record names no pid, only {pid!r}"
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False, f"pid {pid} is gone"
    except PermissionError:
        pass          # Alive and someone else's, which the command settles below.
    except OSError as e:
        return False, f"pid {pid} cannot be asked about: {e}"
    was = rec.get("command") or ""
    seen = process_command(pid)
    if not was:
        # Refused at claim time, so only a hand-edited record reaches this. Without
        # the command there is nothing to separate the watcher from whatever else
        # landed on that pid, and unverifiable is never healthy.
        return False, f"the record cannot say what pid {pid} was, so nothing can say"
    if seen != was:
        return False, (f"pid {pid} is now {seen or 'a process ps will not name'}, "
                       "not the process that recorded it")
    return True, ""


def _staged_text(path, text):
    """Written beside its destination, so it lands whole or not at all. A status
    file caught half-written would read as a fault in a fleet that is fine, and a
    counter caught half-written would read as a number that was never true."""
    tmp = f"{path}.{os.getpid()}"
    with open(tmp, "w") as f:
        f.write(text)
    return tmp


def _staged(path, record):
    return _staged_text(path, json.dumps(record, indent=2) + "\n")


def claim_grant(home, pane):
    """Record this process as the grant, and refuse when another watcher holds it.

    `os.link` refuses an existing destination, so two watchers started together
    cannot both come away believing they are the only one. Two would raise two
    wakes for every report, and this file could only ever describe one of them, so
    the captain would be told about a watcher while another ran unaccounted for."""
    path = os.path.join(home, GRANT)
    command = process_command(os.getpid())
    if not command:
        die(f"`ps` says nothing about this process (pid {os.getpid()})",
            "the record names what this process is so that a later process wearing",
            "the same pid cannot be mistaken for a live grant; without it, nothing",
            "could tell them apart, and a grant nobody can verify is worse than no",
            "grant at all")
    held = read_grant(path)
    if held:
        live, why = still_running(held)
        if live:
            die(f"a watcher is already running (pid {held['pid']})",
                "two would raise two wakes for every report, and only one of them",
                f"could be recorded; stop that one first, or read {path}")
        # The record it left is the only account of what stopped it, so it is said
        # here rather than quietly overwritten.
        print(f"replaced a watcher record that had stopped: {why or 'no reason'}",
              file=sys.stderr, flush=True)
        os.unlink(path)
    tmp = _staged(path, {"state": "running", "pid": os.getpid(), "command": command,
                         "pane": pane, "started": stamp()})
    try:
        os.link(tmp, path)
    except FileExistsError:
        die("another watcher claimed the record while this one was starting",
            "nothing was started here; ask `just doctor` which one is running")
    finally:
        os.unlink(tmp)
    return path


def fail_grant(home, reason):
    """Leave what stopped this watcher where `doctor` will find it.

    The captain is away - that is the whole point of the watcher - so the refusal
    printed on the way out goes to a screen nobody is reading. This is the same
    words, in the one place someone will look when the fleet has gone quiet."""
    path = os.path.join(home, GRANT)
    try:
        rec = read_grant(path)
    except Refusal:
        rec = None
    rec = dict(rec or {})
    rec.update(state="failed", stopped=stamp(), reason=reason)
    os.replace(_staged(path, rec), path)


def release_grant(home):
    """Withdraw the grant by removing its record, because the grant was the process
    and the process is stopping. A record left behind would read as a watcher that
    died, and send the captain looking for something that never happened."""
    try:
        os.unlink(os.path.join(home, GRANT))
    except FileNotFoundError:
        pass


def read_counter(path):
    """The number in a counter file, or None when there is no readable number there.

    An absent file is the zero and never a fault: no wake has been raised yet, or
    none has been taken yet. Anything else that will not read is None rather than
    zero, because the two callers want opposite things from it and only they know
    which - a `pending` that reads as zero would throw away every wake this watcher
    ever raised."""
    try:
        with open(path) as f:
            text = f.read()
    except FileNotFoundError:
        return 0
    except OSError:
        return None
    try:
        n = int(text.strip())
    except ValueError:
        return None
    return n if n >= 0 else None


def read_pending(home):
    """The count of wakes raised so far, which this watcher continues from.

    Continued and never restarted, so the counter is monotonic across a restart. A
    watcher that began again at zero would leave `pending` below the `consumed`
    mark the extension already holds, and every wake it raised after that would look
    to the extension like one already delivered - a fleet that never wakes again,
    with a watcher running and reporting itself healthy the whole time.

    So an unreadable one is a refusal rather than a zero, and it is made in front of
    the captain before the grant is claimed."""
    path = os.path.join(wake_dir(home), PENDING)
    n = read_counter(path)
    if n is None:
        die(f"the wake counter at {path} does not hold a number",
            "this watcher continues the count rather than restarting it, so it",
            "cannot start without knowing where the count is; read that file, and",
            "set it to the number in `consumed` beside it if you have to")
    return n


def raise_wake(home, count, pending):
    """Raise the wake counter by `count`, and answer with where it now stands.

    Written whole with a rename, like the grant record and for the same reason: the
    pi extension reads this file while this writes it, and a reader that caught it
    half-written would take a number that was never true as a high-water mark."""
    path = os.path.join(wake_dir(home), PENDING)
    pending += count
    os.replace(_staged_text(path, f"{pending}\n"), path)
    return pending


def read_consumer(home):
    """The pi session recorded as reading the wake counter, or None when none is.

    A record that will not parse refuses rather than reading as absent, the same way
    the grant record does: "no consumer" and "a consumer whose record nobody can
    read" call for opposite things from the captain."""
    path = os.path.join(wake_dir(home), CONSUMER)
    try:
        with open(path) as f:
            rec = json.load(f)
    except FileNotFoundError:
        return None
    except (OSError, ValueError) as e:
        die(f"the wake consumer record at {path} cannot be read: {e}",
            "nothing here can say whether SIANA is reading its wakes; read that",
            "file, remove it, and restart SIANA so its session writes a new one")
    if not isinstance(rec, dict):
        die(f"the wake consumer record at {path} is not a record pi wrote",
            "read it, remove it, and restart SIANA so its session writes a new one")
    return rec


def confirm_consumer(home, harness):
    """That something in SIANA's session is reading the wakes this raises.

    Checked at startup, where the captain is at the keyboard and a rerun costs them
    a second. Nothing else in this process can tell: a wake is a number in a file,
    so raising one always succeeds, and a watcher with no consumer would sit there
    counting for an afternoon looking exactly like a fleet with nothing to report.
    That silence is the failure the whole grant exists to prevent, so this refuses
    rather than starting.

    There is no fallback to the old terminal write for a session this cannot find a
    consumer for. That write is the bug: it concatenated the captain's unsubmitted
    draft with the wake and submitted both. A fallback would reinstate it in exactly
    the state nobody is watching."""
    path = os.path.join(wake_dir(home), CONSUMER)
    if harness != CONSUMING_HARNESS:
        die(f"SIANA is running in {harness}, which has no collision-free wake path",
            "the wake is delivered inside SIANA's session by a pi extension, which",
            f"is the only place that can see the editor; nothing can start a turn in",
            "a running claude session without typing into the one the captain types",
            "in, and that is the collision this watcher was rewritten to remove",
            "restart SIANA with `siana --harness pi` to have the fleet advance while",
            "you are away")
    rec = read_consumer(home)
    if rec is None:
        die(f"no pi session is reading SIANA's wakes: nothing at {path}",
            "the wake is a counter in that directory and the pi extension `just",
            "init` installs at $SIANA_HOME/.pi/extensions/wake.ts is what reads it;",
            "with nothing reading, every wake this raised would be counted and never",
            "delivered",
            "start SIANA with `siana` before starting this, and run `just init` in",
            "the distro if this is a home from before that extension")
    live, why = still_running(rec)
    if not live:
        die(f"the pi session recorded at {path} is not reading wakes: {why}",
            "it was killed before it could withdraw its record, so nothing in that",
            "session is delivering anything",
            "start SIANA again; its session rewrites this record as it comes up")
    return rec


def fault(lines):
    """A problem in `doctor`'s own shape, on the stream `doctor` puts problems on."""
    print(f"  stale   {lines[0]}", file=sys.stderr)
    for line in lines[1:]:
        print(f"          {line}", file=sys.stderr)
    return 1


def check_grant(home):
    """Report whether the fleet is being watched. Reports, and never repairs.

    Nothing here reads healthy off the file. The record names a process, and what
    makes it a grant is that process still being alive and still being this command:
    a status file is evidence about a watcher and never a substitute for one. That
    is also why a stopped record is left exactly as it is. Removing it is deciding
    the captain has read it, and only the captain can decide that."""
    path = os.path.join(home, GRANT)
    try:
        rec = read_grant(path)
    except Refusal as r:
        return fault(r.lines)
    if rec is None:
        print("  ok      no watcher (the fleet does not advance unattended)")
        return 0
    if rec["state"] == "running":
        live, why = still_running(rec)
        if live:
            print(f"  ok      watcher running (pid {rec['pid']}, pane "
                  f"{rec.get('pane')}, since {rec.get('started')})")
            return 0
        return fault([
            f"watcher stopped without saying why: {why}",
            f"it recorded itself at {rec.get('started')} and left no reason, so it",
            "was killed or the machine went down; the fleet stopped advancing then",
            "and nothing said so",
            f"read {path}, remove it, and start `siana-watch` again beside SIANA"])
    said = (rec.get("reason") or "no reason recorded").splitlines()
    return fault([f"watcher stopped at {rec.get('stopped')}: {said[0]}", *said[1:],
                  f"remove {path} once you have read it, then start `siana-watch`",
                  "again beside SIANA"])


def pane_agent(h, pane):
    """What herdr says is in that pane, or None when it answers that nothing is.

    None is herdr's answer and not its silence: an unreachable herdr knows nothing
    about this pane and is left to propagate, because a caller cannot tell a pane
    apart from any other pane on a fact it never received."""
    try:
        return h.call("agent.get", target=pane)["agent"]
    except Unreachable:
        raise                 # herdr said nothing, so say nothing about the pane.
    except Refusal:
        return None


def confirm_alive(h, pane, home, harness):
    """That pane still holds SIANA, not a shell or somebody else's agent.

    This is the check at startup, where an undetected agent is refused outright:
    the captain is at the keyboard and a rerun costs them a second. Once the loop
    is running the same answer is held instead, because by then nobody is watching
    for the refusal and stopping is the fleet quietly halting.

    `harness` is the one SIANA recorded at startup, and not the set it could have
    started in: a pane running the other one is a pane SIANA is not in, and reading
    those two the same way is a watcher raising wakes nobody will ever take."""
    agent = pane_agent(h, pane)
    if agent and agent.get("agent") == harness:
        return agent
    seen = (agent or {}).get("agent") or "no agent"
    die(f"pane {pane} is not running SIANA: herdr sees {seen}",
        "if SIANA is starting, herdr has not detected it yet: wait and rerun",
        "otherwise that session has exited, and restarting SIANA rewrites",
        f"{home}/session with the pane it lands in")


def reports(path, offset):
    """New terminal records since `offset`, and where to read from next.

    The store is an append-only log of whole records, so a byte offset is the whole
    of the state this needs. A log shorter than the offset was rewritten underneath
    us, so this resumes from the end and reports once: something certainly happened,
    and the wake carries no content that could be wrong about what."""
    try:
        size = os.path.getsize(path)
    except FileNotFoundError:
        return [], 0          # An empty queue has no file until the first append.
    if size < offset:
        return ["the queue was rewritten"], size
    if size == offset:
        return [], offset
    with open(path, "rb") as f:
        f.seek(offset)
        block = f.read()
    # Bytes, and only through the last newline. An append larger than the writer's
    # buffer reaches disk in more than one write, so the tail of a read is routinely
    # half a record; consuming it would drop that report for good and split a
    # multi-byte character across two decodes. Whole lines only, and the remainder
    # stays unread until the rest of it lands.
    end = block.rfind(b"\n") + 1
    if not end:
        return [], offset
    offset += end
    found = []
    for line in block[:end].splitlines():
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            rec = None
        if not isinstance(rec, dict):
            # A whole line that will not parse, or that parses to something which
            # is not a record, is not a partial write, so it is never coming back.
            # Said out loud, because the report it may have carried is exactly what
            # this process exists to deliver.
            print(f"skipped  unreadable record in {path}", file=sys.stderr, flush=True)
            continue
        if rec.get("status") in TERMINAL:
            found.append(f"{rec.get('id')} {rec['status']}")
    return found, offset


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interval", type=float, default=2.0, metavar="S",
                    help="seconds between reads of the queue (default: 2)")
    ap.add_argument("--status", action="store_true",
                    help="report whether a watcher is running, and start nothing")
    args = ap.parse_args()

    home = os.environ.get("SIANA_HOME") or os.path.expanduser("~/.siana")
    if args.status:
        raise SystemExit(check_grant(home))
    tasks_file = os.environ.get("SIANA_TASKS_FILE") or os.path.join(home, "tasks.jsonl")
    pane, harness = read_session(home)
    h = Herdr(os.environ.get("HERDR_SOCKET_PATH", "~/.config/herdr/herdr.sock"))
    confirm_alive(h, pane, home, harness)
    # Before the grant, because a watcher with nowhere to deliver is not a grant at
    # all. Every refusal above and below happens in front of the captain, who can
    # still read it; what the record exists for is the failures after they walk away.
    confirm_consumer(home, harness)
    pending = read_pending(home)
    # The extension makes this directory as its session comes up, and the consumer
    # record it just answered with is in it. Made here anyway so that the one thing
    # standing between a report and a wake is never a missing directory.
    os.makedirs(wake_dir(home), exist_ok=True)

    # A watcher left running in the background is stopped with `kill`, and that is
    # the captain withdrawing the grant rather than a crash. Left on its default
    # disposition, SIGTERM would end this before the record could be withdrawn, and
    # `doctor` would report a watcher that died for every ordinary stop.
    signal.signal(signal.SIGTERM, _interrupted)

    # Recorded only once there is something to record: everything above refuses in
    # front of the captain, who is still at the keyboard and can read it. What this
    # file exists for is the failures that happen after they walk away.
    grant = claim_grant(home, pane)
    print(f"watching {tasks_file}\n"
          f"waking   SIANA at {pane} through {wake_dir(home)}\n"
          f"grant    {grant}", flush=True)
    try:
        watch(h, pane, home, tasks_file, harness, pending, args.interval)
    except KeyboardInterrupt:
        release_grant(home)
        raise
    except BaseException as stop:
        # Every other way out, a traceback included. The reason is left where doctor
        # will find it, because the screen this printed on is one nobody is reading.
        fail_grant(home, str(stop) if isinstance(stop, Refusal)
                   else f"{type(stop).__name__}: {stop}")
        raise


def _interrupted(signum, frame):
    raise KeyboardInterrupt


def watch(h, pane, home, tasks_file, harness, pending, interval):
    """The loop: read the queue, raise a wake for what it finds, and stop the moment
    that pane is no longer SIANA's.

    `harness` is the agent SIANA recorded at startup, and the only name herdr can
    report in that pane without it having been taken over. `pending` is where the
    wake count already stood, which this continues rather than restarts."""
    # Start at the end. Reports from before this began were SIANA's to reconcile in
    # the session that saw them, and replaying them would wake it about work already
    # accounted for. The wake carries no content, so nothing is lost by not knowing
    # what happened while nothing was watching.
    offset = os.path.getsize(tasks_file) if os.path.exists(tasks_file) else 0

    consumed_path = os.path.join(wake_dir(home), CONSUMED)
    # When the count first ran ahead of what SIANA had taken, or None while the two
    # agree. It is the clock for the held warning and for the line that says the
    # wake landed.
    behind_since = None
    undetected_since = None
    while True:
        # Liveness every tick, not only when there is something to deliver. This
        # process is the captain's autonomy grant, so it must never keep running
        # after the session it grants for is gone: a watcher that looks alive while
        # it can wake nobody is the fleet quietly stopping and no one being told.
        #
        # But not knowing what is in that pane is routinely a herdr restart rather
        # than a dead session, so it is held for DETECT_GRACE_S rather than acted on.
        # A restart is one event however it presents - herdr refusing the socket,
        # herdr answering that no agent is there, or herdr answering with a pane it
        # has not re-detected yet - so all three run the same clock.
        #
        # Wakes keep being raised throughout it. The old write was typed into a pane
        # and had to be held while nobody could say whose pane it was; a counter in
        # SIANA's own home cannot be read by somebody else's agent, so holding it
        # would only cost timeliness and buy nothing.
        unsure = None
        try:
            agent = pane_agent(h, pane)
            if not (agent and agent.get("agent")):
                unsure = f"herdr sees no agent in {pane}"
        except Unreachable as e:
            agent, unsure = None, str(e).splitlines()[0]
        if unsure:
            if undetected_since is None:
                undetected_since = time.time()
                print(f"unsure   {unsure}", file=sys.stderr, flush=True)
            if time.time() - undetected_since > DETECT_GRACE_S:
                die(f"pane {pane} has gone {DETECT_GRACE_S:.0f}s without herdr",
                    f"confirming SIANA is in it: {unsure}",
                    "a herdr that restarted answers and re-detects well inside that,",
                    "so this is a session that has exited or a herdr that is not",
                    f"coming back; restarting SIANA rewrites {home}/session with the",
                    "pane it lands in")
        elif agent.get("agent") != harness:
            # Not a gap. Something else holds that pane now, so SIANA has exited and
            # the wakes this raises would sit in the mailbox with nobody reading them.
            die(f"pane {pane} is not running SIANA: herdr sees {agent.get('agent')}",
                "that session has exited and its pane was taken over; restarting",
                f"SIANA rewrites {home}/session with the pane it lands in")
        elif undetected_since is not None:
            undetected_since = None
            print(f"detected herdr sees SIANA at {pane} again", flush=True)

        found, offset = reports(tasks_file, offset)
        if found:
            print(f"report   {', '.join(found)}", flush=True)
            # Raised as one, however many landed together. The wake carries no
            # content, so a second one would only spend a turn saying the same thing.
            pending = raise_wake(home, len(found), pending)
            print(f"raised   {len(found)} wake(s); {pending} in all", flush=True)

        # What SIANA's session says it has taken. Unreadable reads as nothing taken,
        # which is the safe direction: it can only ever produce the warning below,
        # never a wake dropped on the strength of a file nobody could parse.
        consumed = read_counter(consumed_path)
        if consumed is None:
            consumed = 0
        if pending > consumed:
            # A warning on the settle cadence and never a deadline. The count is on
            # disk, so a session that comes back drains it at startup however long it
            # was away - but held silently, a captain reading a watcher that is
            # plainly running has no way to know nothing has moved.
            if behind_since is None:
                behind_since = time.time()
            elif time.time() - behind_since > SETTLE_WARN_S:
                behind_since = time.time()
                # What this can see is that the two counters disagree, and that is
                # all it says. Two states produce it and they want opposite things:
                # a session that is gone, and a session that is there and holding
                # every wake behind a draft the captain left in the editor. Naming
                # the first would send them to restart SIANA, which is exactly what
                # discards the draft this whole path exists to protect.
                print(f"held     SIANA has taken {consumed} of {pending} wake(s) in "
                      f"{SETTLE_WARN_S:.0f}s\n"
                      "         a draft left in its editor holds every wake until it "
                      "is sent or cleared;\n"
                      "         `just doctor` says whether that session is there at "
                      "all", file=sys.stderr, flush=True)
        elif behind_since is not None:
            behind_since = None
            print(f"woken    SIANA has taken all {consumed} wake(s)", flush=True)
        time.sleep(interval)


if __name__ == "__main__":
    try:
        main()
    except Refusal as r:
        print(str(r), file=sys.stderr)
        raise SystemExit(1) from None
    except KeyboardInterrupt:
        print("\nstopped; SIANA no longer advances the fleet unattended")
