#!/usr/bin/env python3
"""Wake SIANA when a minion reports, so the fleet does not idle while nobody looks.

SIANA is turn-based. It cannot hold Herdr's event subscription open between turns,
so without this a minion that finishes is discovered whenever the captain next takes
a turn, and everything downstream of it waits that long for no reason.

This watches the queue, not the fleet. Herdr says a process stopped, never that it
succeeded, and its `idle` covers both a minion that finished and one that asked a
question in prose and stalled forever. The queue is the only report that counts, so
a terminal record appended to `tasks.jsonl` is the only thing that pokes anyone.

**The poke carries no content.** It says the queue moved and nothing else, because
anything it summarised would be a second source of truth able to disagree with the
store SIANA is about to read anyway. That is also why a missed poke costs only
timeliness: the store still holds everything, and the next poke or the next turn
recovers the whole picture. Never make this the report.

**Running this is the captain's autonomy grant.** SIANA reconciles and dispatches
ready work when poked, so while this runs the fleet advances without the captain in
the room. The grant is this process: it is given by starting it and withdrawn by
stopping it, which is why it lives nowhere else. No flag, no registry field, and no
record outlives it, so a grant can never be inherited by a session the captain did
not choose to leave running.

Usage:
    siana-watch [--interval S]

It runs until interrupted. SIANA's session is found through `$SIANA_HOME/session`,
written by `siana` at startup, so this must be started after SIANA is up.
"""

import argparse
import json
import os
import socket
import sys
import time

# What a minion writes and SIANA does not. SIANA calls add, start, dep, drop and
# reset, none of which land here, so this predicate isolates minion reports without
# guessing from owners. A `done` SIANA typed itself costs one wasted reconcile.
TERMINAL = {"done", "blocked"}

# How long SIANA may stay mid-turn before this says so. It is a warning and never a
# deadline: a report is held until it can be delivered, however long that takes,
# because SIANA can be blocked waiting on the captain and the captain can be away.
SETTLE_WARN_S = 300.0

# How long a pane may answer "no agent here" before this calls the session gone.
# Herdr loses its pane metadata across a server restart and re-detects each agent
# from the pane itself, so for a few seconds after a routine `herdr update` it
# truthfully reports no agent in a pane SIANA is alive and working in. Two minutes
# is far longer than that restart and re-detection take together, so anything still
# undetected at the end of it has really exited - and it is short enough that a
# session that did exit is said out loud long before the captain, seeing this process
# still running, has spent an afternoon believing the fleet was advancing.
DETECT_GRACE_S = 120.0


class Refusal(SystemExit):
    """A refusal that still knows what it said, matching siana-dispatch."""

    def __init__(self, lines):
        self.lines = lines
        super().__init__(1)

    def __str__(self):
        return "\n".join(self.lines)


class Unreachable(Refusal):
    """herdr itself never answered, which is a fact about herdr and about nothing
    else. A caller asking after a pane must not read it as an answer about that
    pane: reporting a live session as gone is how a captain is talked into
    abandoning one."""


def die(*lines, kind=Refusal):
    raise kind(list(lines))


class Herdr:
    """One request, one connection. Same protocol and timeout as siana-dispatch.

    The timeout is the point: a herdr that accepts the connection and then says
    nothing - wedged, stopped mid-request, or a listener bound by a server still
    starting - would otherwise park this process inside `recv` forever. A watcher
    parked there is the one thing this must never be, a process that looks like a
    live autonomy grant while it polls nothing and can wake nobody."""

    def __init__(self, path, timeout=30.0):
        self.path, self.timeout = os.path.expanduser(path), timeout

    def call(self, method, **params):
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(self.timeout)
            s.connect(self.path)
        except OSError as e:
            die(f"herdr is not reachable at {self.path}: {e}",
                "the session SIANA runs in lives in herdr; start it first",
                kind=Unreachable)
        with s:
            try:
                s.sendall((json.dumps({"id": "siana-watch", "method": method,
                                       "params": params}) + "\n").encode())
                buf = b""
                while not buf.endswith(b"\n"):
                    chunk = s.recv(65536)
                    if not chunk:
                        die(f"herdr closed the connection during {method}",
                            kind=Unreachable)
                    buf += chunk
            except OSError as e:
                die(f"herdr stopped answering during {method}: {e}",
                    "it accepted the connection and then said nothing, so nothing",
                    "here knows anything about SIANA's pane",
                    kind=Unreachable)
        reply = json.loads(buf)
        if "error" in reply:
            err = reply["error"]
            die(f"herdr refused {method}: {err.get('message', err)}")
        return reply.get("result", {})


def read_session(home):
    """SIANA's pane id, which is the only durable handle back to its session.

    Herdr's labels are not unique and its pane metadata is wiped when its server
    restarts, so this reads what `siana` recorded and never searches for a pi agent
    that looks about right. A stale file names a pane that is gone or now holds
    something else, and both are refusals rather than a poke sent into whatever
    happens to be there now."""
    path = os.path.join(home, "session")
    if not os.path.isfile(path):
        die(f"no SIANA session recorded at {path}",
            "`siana` writes it at startup and removes it at exit, so SIANA is not",
            "running; start it first, then start this")
    fields = {}
    with open(path) as f:
        for line in f:
            if "=" in line:
                k, v = line.split("=", 1)
                fields[k.strip()] = v.strip()
    pane = fields.get("SIANA_PANE")
    if not pane:
        # A SIANA outside herdr is a working SIANA, just one with no pane to prompt.
        # Saying which of the two it is beats reporting a missing session that is
        # sitting right there in front of the captain.
        die(f"SIANA (pid {fields.get('SIANA_PID', '?')}) is running outside herdr",
            "nothing can wake a session herdr does not host; restart SIANA inside",
            "herdr if you want the fleet to advance while you are away")
    return pane


def pane_agent(h, pane):
    """What herdr says is in that pane, or None when it answers that nothing is.

    None is herdr's answer and not its silence: an unreachable herdr knows nothing
    about this pane and is left to propagate, because a caller cannot tell a pane
    apart from any other pane on a fact it never received."""
    try:
        return h.call("agent.get", target=pane)["agent"]
    except Unreachable:
        raise                 # herdr said nothing, so say nothing about the pane.
    except Refusal:
        return None


def confirm_alive(h, pane, home):
    """That pane still holds SIANA, not a shell or somebody else's agent.

    This is the check at startup, where an undetected agent is refused outright:
    the captain is at the keyboard and a rerun costs them a second. Once the loop
    is running the same answer is held instead, because by then nobody is watching
    for the refusal and stopping is the fleet quietly halting."""
    agent = pane_agent(h, pane)
    if agent and agent.get("agent") == "pi":
        return agent
    seen = (agent or {}).get("agent") or "no agent"
    die(f"pane {pane} is not running SIANA: herdr sees {seen}",
        "if SIANA is starting, herdr has not detected it yet: wait and rerun",
        "otherwise that session has exited, and restarting SIANA rewrites",
        f"{home}/session with the pane it lands in")


def reports(path, offset):
    """New terminal records since `offset`, and where to read from next.

    The store is an append-only log of whole records, so a byte offset is the whole
    of the state this needs. A log shorter than the offset was rewritten underneath
    us, so this resumes from the end and reports once: something certainly happened,
    and the poke carries no content that could be wrong about what."""
    try:
        size = os.path.getsize(path)
    except FileNotFoundError:
        return [], 0          # An empty queue has no file until the first append.
    if size < offset:
        return ["the queue was rewritten"], size
    if size == offset:
        return [], offset
    with open(path, "rb") as f:
        f.seek(offset)
        block = f.read()
    # Bytes, and only through the last newline. An append larger than the writer's
    # buffer reaches disk in more than one write, so the tail of a read is routinely
    # half a record; consuming it would drop that report for good and split a
    # multi-byte character across two decodes. Whole lines only, and the remainder
    # stays unread until the rest of it lands.
    end = block.rfind(b"\n") + 1
    if not end:
        return [], offset
    offset += end
    found = []
    for line in block[:end].splitlines():
        if not line.strip():
            continue
        try:
            rec = json.loads(line)
        except (json.JSONDecodeError, UnicodeDecodeError):
            # A whole line that will not parse is not a partial write, so it is
            # never coming back. Said out loud, because the report it may have
            # carried is exactly what this process exists to deliver.
            print(f"skipped  unreadable record in {path}", file=sys.stderr, flush=True)
            continue
        if rec.get("status") in TERMINAL:
            found.append(f"{rec.get('id')} {rec['status']}")
    return found, offset


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interval", type=float, default=2.0, metavar="S",
                    help="seconds between reads of the queue (default: 2)")
    args = ap.parse_args()

    home = os.environ.get("SIANA_HOME") or os.path.expanduser("~/.siana")
    tasks_file = os.environ.get("SIANA_TASKS_FILE") or os.path.join(home, "tasks.jsonl")
    pane = read_session(home)
    h = Herdr(os.environ.get("HERDR_SOCKET_PATH", "~/.config/herdr/herdr.sock"))
    confirm_alive(h, pane, home)

    # Start at the end. Reports from before this began were SIANA's to reconcile in
    # the session that saw them, and replaying them would poke about work already
    # accounted for. The poke carries no content, so nothing is lost by not knowing
    # what happened while nothing was watching.
    offset = os.path.getsize(tasks_file) if os.path.exists(tasks_file) else 0
    print(f"watching {tasks_file}\npoking   SIANA at {pane}", flush=True)

    # Reading the queue and delivering the poke are separate steps of one tick, so
    # neither can stall the other. Reports that land while SIANA is mid-turn keep
    # accumulating and leave together, because SIANA reads the whole queue and a poke
    # per report would only spend turns saying the same thing.
    pending, waiting_since, warned = [], None, False
    undetected_since = None
    while True:
        # Liveness every tick, not only when there is something to deliver. This
        # process is the captain's autonomy grant, so it must never keep running
        # after the session it grants for is gone: a watcher that looks alive while
        # it can wake nobody is the fleet quietly stopping and no one being told.
        #
        # But "herdr sees no agent there" is routinely a detection gap and not a
        # dead session, so it is held for DETECT_GRACE_S rather than acted on. While
        # it is held no poke goes out: a pane this cannot identify is precisely the
        # pane a poke must not be typed into, and a report waiting costs timeliness
        # where a poke into a stranger's session costs the stranger.
        agent = pane_agent(h, pane)
        if agent is None:
            if undetected_since is None:
                undetected_since = time.time()
                print(f"unsure   herdr sees no agent in {pane}; every poke is held",
                      file=sys.stderr, flush=True)
            if time.time() - undetected_since > DETECT_GRACE_S:
                die(f"pane {pane} has had no detected agent for {DETECT_GRACE_S:.0f}s",
                    "a herdr that restarted re-detects well inside that, so this is a",
                    "session that has exited rather than one not yet recognised;",
                    f"restarting SIANA rewrites {home}/session with its new pane")
            status = None
        elif agent.get("agent") != "pi":
            # Not a gap. Something else holds that pane now, so every poke from here
            # would be typed into somebody else's session. No window makes that safer.
            die(f"pane {pane} is not running SIANA: herdr sees {agent.get('agent')}",
                "that session has exited and its pane was taken over; restarting",
                f"SIANA rewrites {home}/session with the pane it lands in")
        else:
            if undetected_since is not None:
                undetected_since = None
                print(f"detected herdr sees SIANA at {pane} again; pokes resume",
                      flush=True)
            status = agent.get("agent_status")
        found, offset = reports(tasks_file, offset)
        if found:
            print(f"report   {', '.join(found)}", flush=True)
            pending += found
        if pending:
            # A prompt sent into a working agent is typed into a turn already in
            # flight, and one sent into a blocked agent is typed into whatever
            # blocked it, the same hazard dispatch guards against at birth. So wait
            # for a settled state rather than forcing one, however long that takes.
            if status in ("idle", "done"):
                h.call("agent.prompt", target=pane, text="The queue moved. Reconcile it.")
                print(f"poked    {len(pending)} report(s)", flush=True)
                pending, waiting_since, warned = [], None, False
            elif status is not None:
                waiting_since = waiting_since or time.time()
                if not warned and time.time() - waiting_since > SETTLE_WARN_S:
                    warned = True
                    print(f"waiting  SIANA has been mid-turn for {SETTLE_WARN_S:.0f}s; "
                          f"{len(pending)} report(s) held", file=sys.stderr, flush=True)
        time.sleep(args.interval)


if __name__ == "__main__":
    try:
        main()
    except Refusal as r:
        print(str(r), file=sys.stderr)
        raise SystemExit(1) from None
    except KeyboardInterrupt:
        print("\nstopped; SIANA no longer advances the fleet unattended")
