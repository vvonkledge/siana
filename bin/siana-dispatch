#!/usr/bin/env python3
"""Put a minion on a task: its own worktree, one Herdr workspace, one agent, one prompt.

This is mechanics, not judgment. SIANA has already decided the task exists and which
project it belongs to. This script only carries that decision into a running agent,
and it stops and reports rather than guessing when the world surprises it.

Everything about where and how comes from two records, never from the command line:
the task says which project it belongs to, and the captain's registry says what that
project is. So a path is never typed, and a typo cannot start a minion in the wrong
tree. A task with no project is refused, because a dispatch that guesses a directory
is the false-green this fleet exists to prevent.

Per-project configuration lives in the `$SIANA_HOME/projects.jsonl` store:

    handle:   what the captain calls the project
    path:     where minions run and where verification happens   (required)
    ship:     the project's delivery rigor; SIANA types it into `tasks add
              --verify`. Read by SIANA, not enforced here.
    qa:       independent validation of ship work; `siana-brief` types it into
              the paired QA task's `--verify`. Read there, not here.
    orders:   extra standing orders for this project, relative to `path`
    worktree: false only for a project that is not a git repository

A minion's worktree branches from whatever the project is checked out to, unless
the task carries a `base`. That is how a QA task is put on the branch it was
queued to judge, rather than on a tree that never held the work. `siana-brief`
writes it onto a QA task, and SIANA writes it onto follow-up work that has to
start from an existing branch rather than from the project's default one.

Shape and types are the store contract's job, enforced when a record is written.
What is left here is the part a contract cannot check: that the directory and the
orders file actually exist on this machine right now.

Usage:
    siana-dispatch <task-id> [--label <text>] [--env K=V ...] [--prompt <text>]
    siana-dispatch --check

On success it prints the binding SIANA needs to find this minion again.

`--check` dispatches nothing. It resolves every project exactly as a dispatch would,
and then asks Herdr whether the pane each in-flight task is bound to still holds its
minion. Both live here because both are about bindings this script made: a check with
its own parser could pass while a real dispatch fails.
"""

import argparse
import json
import os
import re
import socket
import subprocess
import sys
import time

# Only claude is verified end to end (2026-08-26, herdr 0.8.0, protocol 19). Other
# kinds are refused rather than guessed: a wrong flag here starts an agent that
# silently has no orders, which looks exactly like a working dispatch.
AGENTS = {
    "claude": {"args": ["--dangerously-skip-permissions"],
               "orders_flag": "--append-system-prompt-file"},
}

READY_TIMEOUT_S = 90.0
PROMPT_LANDED_S = 8.0

# A minion's herdr agent name is its task id, so the queue's id grammar has to fit
# inside herdr's name grammar. It does not: `tasks` allows 3 to 48 characters and
# herdr allows 1 to 32 (verified 2026-08-28, herdr 0.8.0), so an id of 33 to 48 is
# valid in the queue and refused by `agent.start`. Checked here, before anything is
# created, because the same refusal after the claim costs a workspace and a rollback.
HERDR_AGENT_NAME = re.compile(r"[a-z][a-z0-9_-]{0,31}")


class Refusal(SystemExit):
    """A refusal that still knows what it said.

    A bare `SystemExit(1)` stringifies to "1", so every `in str(e)` check that
    tried to react to one silently never matched. Carrying the text means a
    caller can inspect a refusal, report a whole registry instead of stopping at
    the first bad entry, and turn a raw herdr code into a usable hint."""

    def __init__(self, message: str, hints=()):
        self.message, self.hints = message, tuple(hints)
        super().__init__(1)

    def __str__(self) -> str:
        return self.message


class Unreachable(Refusal):
    """herdr never answered. It is one fact about herdr and says nothing about any
    pane, workspace or minion, so a caller asking after one must not read it as an
    answer about that one: a live fleet reported dead is worse than an unread one."""


def die(message: str, *hints: str, kind=Refusal):
    raise kind(message, hints)


def gone(r: "Refusal") -> bool:
    """herdr answering that no live agent holds this name right now.

    A name is bound to a live agent and freed the moment that agent exits, so a
    minion that dies mid-dispatch reads as `agent_not_found` rather than as an
    unready one. Inside a polling loop that is an observation about this instant,
    never an answer about the pane: the loop's own timeout refusal carries the pane
    id and the owner and a raw herdr line carries neither. Switching to pane-id
    targeting does not avoid this - a live pane holding no agent answers
    `agent_not_found` too.
    """
    return "agent_not_found" in str(r)


def report(r: "Refusal") -> None:
    print(f"error: {r.message}", file=sys.stderr)
    for h in r.hints:
        print(f"  {h}", file=sys.stderr)


class Herdr:
    """One connection per call: the server closes the socket after each response.
    Only events.subscribe keeps a connection open, and this script never needs it."""

    def __init__(self, path: str, timeout: float = 30.0) -> None:
        self.path, self.timeout, self.seq = path, timeout, 0

    def call(self, method: str, **params):
        self.seq += 1
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
            sock.settimeout(self.timeout)
            try:
                sock.connect(self.path)
            except OSError as e:
                die(f"cannot reach herdr at {self.path}: {e}", kind=Unreachable)
            try:
                sock.sendall((json.dumps(
                    {"id": f"req_{self.seq}", "method": method, "params": params}) + "\n").encode())
                buf = b""
                while b"\n" not in buf:
                    chunk = sock.recv(65536)
                    if not chunk:
                        die(f"herdr {method}: connection closed without a response",
                            kind=Unreachable)
                    buf += chunk
            except OSError as e:
                die(f"herdr {method}: {e}", kind=Unreachable)
        msg = json.loads(buf.split(b"\n", 1)[0])
        if "error" in msg:
            die(f"herdr {method}: {msg['error'].get('code')}: {msg['error'].get('message')}")
        return msg["result"]


def fold(store: str, key: str):
    """Fold an append-only datafile store into {key: record}.

    Only reads go this way; every write still goes through `tasks` or `datafile`,
    so what is on disk has already passed its contract. The log is append-only, so
    the last line for an id wins, and a tombstone is a last line like any other: a
    dropped record must read as absent, not as a record with every field missing.

    A store with no writes yet has no file at all, which is an empty store rather
    than a fault."""
    out = {}
    if not os.path.isfile(store):
        return out
    with open(store) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            rec = json.loads(line)
            rid = rec.get(key)
            if rid is None:
                continue
            if rec.get("_deleted"):
                out.pop(rid, None)
            else:
                out[rid] = rec
    return out


def load_registry(store: str, schema: str):
    """The captain's registry. Absent is a stop: dispatching without it means
    dispatching to a path nobody wrote down.

    The schema is what says the registry exists, because a store with no projects
    yet has no `.jsonl` file at all."""
    if not os.path.isfile(schema):
        die(f"no project registry at {store}",
            "the registry is what turns a project handle into a directory",
            "run `just init` in the distro")
    return fold(store, "handle")


def resolve(projects: dict, handle: str, store: str):
    """Handle to configuration. Exact lookup, no inference: a handle that is not in
    the registry is the captain's to add, never this script's to guess.

    Types and required keys were settled by the contract when the record was
    written, so what is checked here is only what a contract cannot see: whether
    the directory and the orders file exist on this machine right now."""
    if handle not in projects:
        known = ", ".join(sorted(projects)) or "(the registry is empty)"
        die(f"unknown project: {handle}",
            f"known handles: {known}",
            f"the captain adds projects to {store}; a path is never guessed")
    cfg = projects[handle]

    path = os.path.abspath(os.path.expanduser(str(cfg["path"])))
    if not os.path.isdir(path):
        die(f"{handle} points at {path}, which is not a directory",
            f"fix the `path` for {handle} in {store}")

    orders = cfg.get("orders")
    if orders:
        orders = os.path.join(path, str(orders)) if not str(orders).startswith(("/", "~")) \
            else os.path.abspath(os.path.expanduser(str(orders)))
        if not os.path.isfile(orders):
            die(f"{handle} names project orders at {orders}, which does not exist",
                "a minion started without orders it was promised is a silent",
                "half-briefing; fix the `orders` entry or remove it")

    # `worktree` carries a default of true in the contract, so it is materialised on
    # write. A record predating the field is still read as isolated, which is the
    # safe direction: isolation withheld is a data-loss risk, isolation added is not.
    return {"path": path, "orders": orders, "worktree": cfg.get("worktree", True),
            "ship": cfg.get("ship"), "qa": cfg.get("qa")}


def assemble_orders(home: str, task_id: str, base: str, project_orders, handle: str) -> str:
    """One orders file, always.

    claude's --append-system-prompt-file does not accumulate: passing it twice keeps
    only the last file and silently drops the first, with no error (verified
    2026-08-26). So project orders are concatenated here rather than passed as a
    second flag, which would have dropped the fleet's standing orders entirely.

    The combined file is durable rather than temporary, because the agent may reread
    it when its session resumes, and because what a minion was actually told should
    outlive the dispatch that told it."""
    if not project_orders:
        return base
    out_dir = os.path.join(home, "orders")
    os.makedirs(out_dir, exist_ok=True)
    combined = os.path.join(out_dir, f"{task_id}.md")
    with open(base) as fh:
        text = fh.read()
    with open(project_orders) as fh:
        text += (f"\n\n---\n\n# Project orders: {handle}\n\n"
                 f"These apply to every task in this project, on top of the standing\n"
                 f"orders above. Where they conflict, these are more specific and win.\n\n"
                 + fh.read())
    with open(combined, "w") as fh:
        fh.write(text)
    return combined


def check_registry(registry: str, schema: str) -> int:
    """Every handle resolved exactly as a dispatch would resolve it, so a path that
    has moved surfaces here rather than halfway through starting a minion."""
    projects = load_registry(registry, schema)
    if not projects:
        print(f"registry {registry}\n  empty  no projects yet")
        return 0
    print(f"registry {registry}")
    failed = 0
    for handle in sorted(projects):
        try:
            cfg = resolve(projects, handle, registry)
        except Refusal as r:
            print(f"  BROKEN  {handle}: {r.message}")
            for h in r.hints:
                print(f"            {h}")
            failed += 1
            continue
        notes = []
        if cfg["ship"]:
            notes.append(f"ship: {cfg['ship']}")
        if cfg["qa"]:
            notes.append(f"qa: {cfg['qa']}")
        if cfg["orders"]:
            notes.append(f"orders: {os.path.relpath(cfg['orders'], cfg['path'])}")
        if not cfg["worktree"]:
            notes.append("no worktree")
        if not os.path.isdir(os.path.join(cfg["path"], ".git")) and cfg["worktree"]:
            notes.append("WARNING: not a git repo, but worktree isolation is on")
        suffix = f"  ({'; '.join(notes)})" if notes else ""
        print(f"  ok      {handle} -> {cfg['path']}{suffix}")
    return 1 if failed else 0


def check_owners(tasks_file: str) -> int:
    """Report whether the pane each in-flight task is bound to still holds its minion.

    A dead minion is the one failure the fleet cannot see. It appends nothing, so the
    watcher never fires; `--stale` covers only `todo` and `blocked`, so no age ever
    flags it; and its task sits in `doing` forever with everything behind it waiting.

    This only reports. Reclaiming is `tasks reset`, and it stays manual because the
    worktree behind a dead minion may hold work nobody has landed, and because herdr
    cannot tell a minion that finished from one stalled on a prose question. What is
    checked here is narrower and unambiguous: whether the pane still holds that kind
    of agent at all. That much is mechanics; what to do about it is judgment.
    """
    doing = sorted((t for t in fold(tasks_file, "id").values()
                    if t.get("status") == "doing"),
                   key=lambda t: t.get("id") or "")
    if not doing:
        print("in flight  nothing")
        return 0
    print(f"in flight  {len(doing)} claimed")

    h = Herdr(os.environ.get("HERDR_SOCKET_PATH",
                             os.path.expanduser("~/.config/herdr/herdr.sock")))
    # Reachability once, not once per task: an unanswering herdr is one fact about
    # the world, and repeating it per minion would read as many separate faults.
    try:
        h.call("workspace.list")
    except Refusal as r:
        print(f"  unknown {len(doing)} in flight, none checked: {r.message}")
        print("            herdr is the only way to ask, so say nothing about whether")
        print("            these are alive rather than implying they are")
        return 1

    failed = gone = unchecked = 0
    for t in doing:
        tid, owner = t.get("id"), t.get("owner") or ""
        kind, _, pane = owner.partition("@")
        if not pane:
            print(f"  BROKEN  {tid}: owner {owner or '(none)'} names no pane")
            print("            nothing can find this minion; it was claimed outside dispatch")
            failed += 1
            continue
        try:
            agent = h.call("agent.get", target=pane)["agent"]
        except Unreachable as r:
            print(f"  unknown {tid} and every task after it, unchecked: {r.message}")
            print("            herdr stopped answering partway through, which is a fact")
            print("            about herdr and about none of these minions; rerun once")
            print("            it answers again rather than reading silence as death")
            unchecked = 1
            break
        except Refusal:
            print(f"  GONE    {tid}: herdr has no agent in {pane}")
        else:
            seen = agent.get("agent")
            if seen == kind:
                print(f"  ok      {tid} -> {owner} ({agent.get('agent_status') or 'unknown'})")
                continue
            print(f"  GONE    {tid}: {pane} now holds {seen or 'no agent'}, not {kind}")
        print(f"            look at its worktree before `tasks reset {tid}`; a refusal")
        print("            to discard unlanded work is a finding, not an obstacle")
        failed += 1
        gone += 1
    if gone:
        # A herdr whose server restarted has lost its pane metadata and re-detects
        # each agent from the pane itself, so until that finishes it truthfully
        # reports no agent in a pane a live minion is working in. GONE is a reading
        # of this moment, not a verdict.
        print("  note    a herdr that restarted recently reads as GONE everywhere until")
        print("          it has re-detected its agents; rerun before acting on this")
    return 1 if failed or unchecked else 0


def main() -> None:
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("task_id", nargs="?",
                    help="the task to dispatch; omit only with --check")
    ap.add_argument("--check", action="store_true",
                    help="resolve every project in the registry, report whether "
                         "each in-flight minion is still alive, and dispatch nothing")
    ap.add_argument("--label", help="workspace label the captain sees (default: the task id)")
    ap.add_argument("--env", action="append", default=[], metavar="K=V",
                    help="extra environment for the minion; repeatable")
    ap.add_argument("--kind", default="claude", choices=sorted(AGENTS),
                    help="agent kind; only verified kinds are offered")
    ap.add_argument("--prompt", default="Take your task.",
                    help="the dispatch trigger; the contract itself lives in the queue")
    args = ap.parse_args()

    home = os.environ.get("SIANA_HOME") or os.path.expanduser("~/.siana")
    tasks_file = os.environ.get("SIANA_TASKS_FILE") or os.path.join(home, "tasks.jsonl")
    base_orders = os.path.join(home, "orders.md")
    registry = os.path.join(home, "projects.jsonl")
    registry_schema = os.path.join(home, "schema-projects.yaml")

    # Reading the registry the same way a dispatch reads it is the point: a check
    # that used its own parser could pass while a real dispatch fails.
    if args.check:
        rc = check_registry(registry, registry_schema)
        print()
        raise SystemExit(max(rc, check_owners(tasks_file)))
    if not args.task_id:
        die("which task?", "usage: siana-dispatch <task-id>",
            "run `siana-dispatch --check` to inspect the registry instead")

    # The minion is named after its task, so a task the queue accepts can still be
    # one herdr will not name an agent. Refused here, before a worktree or a claim
    # exists, rather than by `agent.start` after both do.
    if not HERDR_AGENT_NAME.fullmatch(args.task_id):
        die(f"{args.task_id} cannot be a herdr agent name",
            "a minion is named after its task, and herdr allows 1 to 32 characters",
            "of [a-z][a-z0-9_-], where the queue allows up to 48",
            "re-add the task under a shorter id; nothing has been created for this one")

    if not os.path.isfile(tasks_file):
        die(f"no task store at {tasks_file}", "run `just init` in the distro")
    if not os.path.isfile(base_orders):
        die(f"no standing orders at {base_orders}",
            "a minion with no orders does not know how to report back",
            "run `just init` in the distro")

    task = fold(tasks_file, "id").get(args.task_id)
    if task is None:
        die(f"no such task: {args.task_id}",
            f"run `tasks --file {tasks_file} list` to see the queue")

    # Where the minion works is the task's project, not an argument. A task that
    # cannot name its project is not yet a task, so this refuses rather than
    # falling back to a directory nobody chose.
    handle = task.get("project")
    if not handle:
        die(f"{args.task_id} carries no project",
            "every task belongs to exactly one project, and the project is what",
            "says where the minion works and which orders it gets",
            f"set it with `tasks --file {tasks_file} add ... --project <handle>`")

    project = resolve(load_registry(registry, registry_schema), handle, registry)
    # The ref this minion's tree is cut from. A task written before the contract
    # carried the field reads as None, which is the same as the default it always
    # had: the project's own checkout.
    base = task.get("base")
    if base and not project["worktree"]:
        die(f"{args.task_id} names base {base}, but {handle} has worktree isolation off",
            "there is no branch to make, so the minion would work in the project",
            "tree at whatever it is checked out to and never see that base at all")
    cwd = project["path"]
    orders = assemble_orders(home, args.task_id, base_orders, project["orders"], handle)

    env = {"SIANA_HOME": home, "SIANA_TASKS_FILE": tasks_file, "SIANA_TASK_ID": args.task_id}
    for pair in args.env:
        if "=" not in pair:
            die(f"--env needs K=V, got {pair!r}")
        k, v = pair.split("=", 1)
        env[k] = v

    h = Herdr(os.environ.get("HERDR_SOCKET_PATH", os.path.expanduser("~/.config/herdr/herdr.sock")))

    # The container comes first, because the pane id is the durable handle the queue
    # records. herdr does not enforce unique labels, so the label is for the captain's
    # eyes only and never authorizes a lookup.
    label = args.label or args.task_id
    branch = None
    if not project["worktree"]:
        # workspace.create carries env, so the minion's identity is set at pane birth.
        ws = h.call("workspace.create", label=label, cwd=cwd, focus=False, env=env)
        workspace_id = ws["workspace"]["workspace_id"]
        work_cwd = cwd
        root_pane = pane_id = ws["root_pane"]["pane_id"]
    else:
        branch = f"siana/{args.task_id}"
        try:
            ws = h.call("worktree.create", cwd=cwd, branch=branch, base=base,
                        label=label, focus=False)
        except Refusal as e:
            if "not_git_worktree" in str(e):
                die(f"{handle} is at {cwd}, which is not a git repository",
                    "a minion is isolated by its own worktree, which needs one",
                    f"record {handle} with worktree=false to accept no isolation,",
                    "which also means only one minion at a time there:",
                    f"  datafile -f {registry} get {handle}   # then put it back",
                    "  ... --set worktree=false")
            if base and "invalid reference" in str(e):
                die(f"{args.task_id} branches from {base}, which this repository does not have",
                    "the work it was queued to judge is not there under that name;",
                    "the branch may have been landed and deleted, or never made at all",
                    "look before deciding: a task judging a branch nobody can find is",
                    "a green nobody should trust")
            if "already exists" in str(e):
                die(f"a worktree for {branch} already exists",
                    "a previous minion on this task was never cleaned up",
                    "that worktree may hold unlanded work; look before removing it",
                    "if the work is committed, the branch keeps it: removing only the",
                    "worktree and dispatching again puts a new minion on those commits,",
                    "because a worktree is cut from an existing branch at its own head")
            raise
        workspace_id = ws["workspace"]["workspace_id"]
        work_cwd = ws["worktree"]["path"]
        root_pane = ws["root_pane"]["pane_id"]

        # worktree.create takes no env, and herdr silently ignores unknown params, so
        # passing one there would return success and leave the minion with no identity.
        # Splitting a pane does carry env, so the work pane is made here and the
        # env-less root pane is closed behind it.
        pane_id = h.call("pane.split", direction="right", target_pane_id=root_pane,
                         cwd=work_cwd, env=env, focus=False)["pane"]["pane_id"]
        h.call("pane.close", pane_id=root_pane)

    owner = f"{args.kind}@{pane_id}"

    claimed = False

    def close_container() -> str:
        """Take the container down, and say what is left if anything is.

        The worktree is brand new and nothing has run in it, so removing it cannot
        destroy any work. Where herdr says otherwise it is not forced: a cleanup
        that cannot prove it is safe leaves the directory and reports it.
        """
        if not project["worktree"]:
            h.call("workspace.close", workspace_id=workspace_id)
            return ""
        try:
            h.call("worktree.remove", workspace_id=workspace_id)
        except Unreachable:
            # herdr is not answering at all. Closing the pane would fail the same
            # way, so there is nothing left to try and the caller says what is left.
            raise
        except Refusal:
            # The pane still goes, because a container nothing points at is the
            # thing this must never leave behind, and a directory nobody is told
            # about is one nobody cleans up.
            h.call("workspace.close", workspace_id=workspace_id)
            return f"worktree left behind at {work_cwd}"
        return ""

    def abandon(message: str, *hints: str):
        """Undo a half-made dispatch: release the claim, then take the container
        down. A task held by an owner whose pane is about to close is an orphan the
        next dispatch trips over, and it outlives the workspace by a long way."""
        hints = list(hints)
        if claimed:
            # The claim goes first, because releasing it needs nothing from herdr
            # and this is reached with herdr unreachable.
            released = subprocess.run(
                ["tasks", "--file", tasks_file, "reset", args.task_id,
                 "--reason", f"dispatch abandoned: {message}"],
                capture_output=True, text=True, check=False)
            hints.append(
                f"{args.task_id} is back in the queue; nothing holds it"
                if released.returncode == 0 else
                f"{args.task_id} is still held by {owner}: read that pane, then "
                f"`tasks --file {tasks_file} reset {args.task_id}`")
        try:
            left = close_container()
        except Unreachable as e:
            left = f"workspace {workspace_id} is still open at {work_cwd} ({e})"
        if left:
            print(f"warning: {left}", file=sys.stderr)
        die(message, *hints)

    # `tasks start` is the gate: it refuses unmet dependencies and a task another
    # minion already holds. Claiming after the pane exists means the record carries
    # the real pane id on its first and only write. `--cwd` retargets the task to
    # this minion's own tree, so `done` verifies where the work actually happened
    # rather than in the shared tree the worktree was branched from.
    claim = subprocess.run(["tasks", "--file", tasks_file, "start", args.task_id,
                            "--owner", owner, "--cwd", work_cwd], capture_output=True,
                           text=True, check=False)
    if claim.returncode != 0:
        abandon(f"tasks refused to dispatch {args.task_id}", claim.stdout.strip())
    claimed = True

    spec = AGENTS[args.kind]
    # herdr refuses any agent argument containing a newline ("agent arguments cannot
    # be encoded safely for the target shell"), so multi-line orders must travel as a
    # file path. Verified 2026-08-26: newline is the only rejected character.
    start_args = spec["args"] + [spec["orders_flag"], orders]
    # The last thing that can refuse, and the first that does so holding a claim.
    # herdr enforces one live agent per name server-wide, so this is where a
    # previous minion on this task announces itself rather than being typed over.
    try:
        h.call("agent.start", name=args.task_id, kind=args.kind, pane_id=pane_id,
               args=start_args)
    except Refusal as e:
        if "agent_name_taken" in str(e):
            # herdr names the incumbent in its own message, and that pane is exactly
            # what the captain needs: it is a previous minion on this same task.
            at = re.search(r"pane_id=(\S+)", str(e))
            where = f" at {at.group(1)}" if at else ""
            abandon(f"a live agent is already named {args.task_id}{where}",
                    "that is a previous minion on this task; read it before you"
                    " replace it" if at else
                    "herdr did not say which pane; `herdr agent list` will",
                    "a name is only freed when its pane closes, so a launch that never",
                    "produced an agent still holds one")
        if "invalid_agent_name" in str(e):
            abandon(f"herdr will not name an agent {args.task_id}",
                    "a minion is named after its task, and herdr allows 1 to 32",
                    "characters of [a-z][a-z0-9_-]", str(e))
        abandon(f"herdr would not start a minion on {args.task_id}", str(e))

    # agent.wait is level-triggered, so it answers "is in this state now" and can
    # return before the agent has drawn anything. The honest readiness test is that
    # herdr has identified the agent in this pane, not that the pane is quiet.
    deadline = time.time() + READY_TIMEOUT_S
    agent = {}
    while time.time() < deadline:
        try:
            agent = h.call("agent.get", target=args.task_id)["agent"]
        except Refusal as e:
            if not gone(e):
                raise
            agent = {}          # A minion that died mid-poll is one that is not ready.
        if agent.get("agent") and agent.get("interactive_ready"):
            break
        time.sleep(0.5)
    else:
        die(f"{args.task_id} did not become ready in {READY_TIMEOUT_S:.0f}s",
            f"the pane is alive at {pane_id}; read it before deciding what to do",
            f"the task is held by {owner}, so reclaim it with `tasks reset` if the minion is gone")

    # A minion can be born blocked: an untrusted directory raises a modal dialog that
    # --dangerously-skip-permissions does not skip. Prompting into a modal types the
    # task into a dialog box, so stop and let SIANA look instead.
    if agent.get("agent_status") == "blocked":
        die(f"{args.task_id} is blocked before it has its task",
            f"read {pane_id}; a first-run trust dialog for {cwd} is the usual cause",
            f"the task is held by {owner}")

    # Delivering a prompt is not the same as it arriving. `interactive_ready` flips
    # true while the agent's TUI still cannot accept input, and a prompt sent in that
    # window is swallowed silently: the dispatch looks successful and the minion sits
    # forever holding a task it never saw. So confirm the effect, and re-send once.
    # Anything other than `idle` means the minion took it.
    vanished = False

    def status() -> str:
        """What herdr says the agent is doing, or "gone" when it says nothing is.

        An agent that died between the readiness check and here answers
        `agent_not_found` to everything it is asked. That is not delivery, and this
        loop's own refusal is the one that should say so: a raw herdr line names
        neither the pane nor the owner.
        """
        nonlocal vanished
        try:
            return h.call("agent.get", target=args.task_id)["agent"].get("agent_status")
        except Refusal as e:
            if not gone(e):
                raise
            vanished = True
            return "gone"

    def delivered(within: float) -> bool:
        limit = time.time() + within
        while time.time() < limit:
            if status() not in ("idle", "gone"):
                return True
            time.sleep(0.5)
        return False

    def send() -> None:
        """Same reasoning: a prompt at an agent that is gone is refused by herdr,
        and swallowing that refusal is what lets the loop reach its own."""
        nonlocal vanished
        try:
            h.call("agent.prompt", target=args.task_id, text=args.prompt)
        except Refusal as e:
            if not gone(e):
                raise
            vanished = True

    send()
    if not delivered(PROMPT_LANDED_S):
        send()
        if not delivered(PROMPT_LANDED_S * 2):
            die(f"{args.task_id} did not take its prompt",
                f"herdr has no agent in {pane_id} any more: it exited mid-dispatch"
                if vanished else
                f"the minion is alive at {pane_id} but never started working",
                f"the task is held by {owner}; reclaim it with `tasks reset` if it stays idle")

    print(json.dumps({"task_id": args.task_id, "owner": owner, "project": handle,
                      "workspace_id": workspace_id, "pane_id": pane_id,
                      "kind": args.kind, "project_path": cwd, "cwd": work_cwd,
                      "branch": branch, "base": base, "orders": orders}, indent=2))


if __name__ == "__main__":
    try:
        main()
    except Refusal as r:
        report(r)
        raise SystemExit(1) from None
