#!/usr/bin/env bash
# The captain's one interface. Opens a pi session in SIANA's home, where the
# fleet queue and SIANA's own instructions live.
set -euo pipefail

home="${SIANA_HOME:-$HOME/.siana}"
env_file="$home/siana.env"

if [ ! -f "$env_file" ]; then
    echo "SIANA is not initialized at $home" >&2
    echo "  run: just init${SIANA_HOME:+ '$home'}" >&2
    exit 1
fi

# Config is a flat env file so it stays readable and hand-editable. It carries
# the resolved path to datafile.py because tasks.py locates its storage engine
# relative to the path it was invoked as, and that lookup breaks through a symlink.
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

cd "$home"

# The registry tells SIANA which projects exist and where they live. Appending it
# to the system prompt makes that a guarantee rather than a read SIANA might skip.
#
# The fields are pinned rather than left to the default view, because `list` shows
# only the first few and would silently drop `worktree` - and a registry that looks
# complete while hiding a project's isolation policy is worse than no registry.
#
# A registry that cannot be read is a stop, not an empty registry. Injecting an
# error message here would leave SIANA believing the captain has no projects.
#
# Both blocks build one string rather than passing the flag twice. claude's
# --append-system-prompt-file keeps only the last of two and silently drops the
# first (see siana-dispatch), and a fleet that assumed otherwise would start SIANA
# with half the context it believes it has. One flag cannot have that bug.
context=""
if [ -f "$home/schema-projects.yaml" ]; then
    if ! registry="$(datafile -f "$home/projects.jsonl" \
            list --fields handle,path,ship,orders,worktree 2>&1)"; then
        echo "the project registry at $home/projects.jsonl is not readable" >&2
        echo "$registry" >&2
        exit 1
    fi
    context="# The captain's projects ($home/projects.jsonl)
$registry"
fi

# What SIANA owes the captain and has not yet paid. Injected for the same reason the
# registry is: an obligation SIANA has to remember to go and look for is an
# obligation kept in memory, which is the whole thing this store replaces. A promise
# survives the session that made it only if the next session is told about it.
#
# Nothing owed is injected too, and is not skipped as an empty section: "owed
# nothing" is a fact SIANA needs, and its absence would read as never having asked.
#
# Unreadable is a stop, exactly as it is for the registry. Injecting the error text
# instead would leave SIANA believing it owes the captain nothing, which is the one
# wrong answer this store must never give.
if [ -f "$home/schema-obligations.yaml" ]; then
    if ! owed="$(siana-owe 2>&1)"; then
        echo "the obligations at $home/obligations.jsonl are not readable" >&2
        echo "$owed" >&2
        exit 1
    fi
    context="${context:+$context

}# What SIANA owes ($home/obligations.jsonl)
$owed

Record a new one with \`siana-owe promise|decision <text>\`, and retire it with
\`siana-owe close <id> --answer <text>\` when a durable event answers it. Never
close one from recollection, and never carry one in this conversation instead."
fi

prompt=()
[ -n "$context" ] && prompt=(--append-system-prompt "$context")

# One SIANA leads the fleet, and this file is what says which. A second would
# dispatch against the same queue while both believed they were the only one, so
# every task either could claim would be a race, and the captain would be talking to
# one of two agents with no way to tell which.
#
# It carries the pid, because that is what liveness can be asked about, and the pane
# id when there is one, because that is how `siana-watch` wakes this session. The
# pane id comes from the environment herdr sets, never from searching for a pi agent
# that looks about right: herdr's labels are not unique, so a search could poke the
# wrong session.
session="$home/session"

# Whether the recorded session is still running. A pid alone is not enough, because
# pids are reused, so the process wearing it must still be a siana. Anything else
# means the file outlived its session and is ours to take.
alive() {
    local pid
    pid="$(sed -n 's/^SIANA_PID=//p' "$session" 2>/dev/null)" || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    case "$(ps -p "$pid" -o command= 2>/dev/null)" in (*siana*) return 0 ;; esac
    return 1
}

# `ln` is atomic and refuses an existing destination, so two siana starting together
# cannot both win. Writing the content first and linking it into place also means the
# file is never visible half-written, which a reader would mistake for a dead session.
claim() {
    local tmp="$session.$$"
    {
        printf 'SIANA_PID=%s\n' "$$"
        [ -n "${HERDR_PANE_ID:-}" ] && printf 'SIANA_PANE=%s\n' "$HERDR_PANE_ID"
    } > "$tmp"
    if ln "$tmp" "$session" 2>/dev/null; then
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

if ! claim; then
    if alive; then
        pane="$(sed -n 's/^SIANA_PANE=//p' "$session" 2>/dev/null)"
        pid="$(sed -n 's/^SIANA_PID=//p' "$session" 2>/dev/null)"
        echo "SIANA is already leading the fleet (pid $pid)" >&2
        if [ -n "$pane" ]; then
            echo "  it is at pane $pane; attach with \`herdr agent attach $pane\`" >&2
        else
            echo "  it is running outside herdr, so it has no pane to attach to" >&2
        fi
        echo "  a second SIANA would race the first for every task in the queue" >&2
        exit 1
    fi
    # The recorded session is gone, so the file is a leftover from one that was
    # killed before its trap could run. Taking it over is the whole recovery.
    rm -f "$session"
    claim || { echo "cannot take $session; remove it and start again" >&2; exit 1; }
fi
trap 'rm -f "$session"' EXIT

[ -n "${HERDR_PANE_ID:-}" ] || \
    echo "not running under herdr: siana-watch cannot wake this session" >&2

# --approve trusts this directory's project-local pi files. The captain created
# this directory by running init, so the consent is explicit rather than inferred.
pi --approve "${prompt[@]}" "$@"
