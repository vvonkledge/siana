#!/usr/bin/env bash
# The captain's one interface. Opens a pi session in SIANA's home, where the
# fleet queue and SIANA's own instructions live.
set -euo pipefail

home="${SIANA_HOME:-$HOME/.siana}"
env_file="$home/siana.env"

if [ ! -f "$env_file" ]; then
    echo "SIANA is not initialized at $home" >&2
    echo "  run: just init${SIANA_HOME:+ '$home'}" >&2
    exit 1
fi

# Config is a flat env file so it stays readable and hand-editable. It carries
# the resolved path to datafile.py because tasks.py locates its storage engine
# relative to the path it was invoked as, and that lookup breaks through a symlink.
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

cd "$home"

# The registry tells SIANA which projects exist and where they live. Appending it
# to the system prompt makes that a guarantee rather than a read SIANA might skip.
#
# The fields are pinned rather than left to the default view, because `list` shows
# only the first few and would silently drop `worktree` - and a registry that looks
# complete while hiding a project's isolation policy is worse than no registry.
#
# A registry that cannot be read is a stop, not an empty registry. Injecting an
# error message here would leave SIANA believing the captain has no projects.
prompt=()
if [ -f "$home/schema-projects.yaml" ]; then
    if ! registry="$(datafile -f "$home/projects.jsonl" \
            list --fields handle,path,ship,orders,worktree 2>&1)"; then
        echo "the project registry at $home/projects.jsonl is not readable" >&2
        echo "$registry" >&2
        exit 1
    fi
    prompt=(--append-system-prompt "# The captain's projects ($home/projects.jsonl)
$registry")
fi

# --approve trusts this directory's project-local pi files. The captain created
# this directory by running init, so the consent is explicit rather than inferred.
exec pi --approve "${prompt[@]}" "$@"
