#!/usr/bin/env bash
# The captain's one interface. Opens a pi session in SIANA's home, where the
# fleet queue and SIANA's own instructions live.
set -euo pipefail

home="${SIANA_HOME:-$HOME/.siana}"
env_file="$home/siana.env"

if [ ! -f "$env_file" ]; then
    echo "SIANA is not initialized at $home" >&2
    echo "  run: just init${SIANA_HOME:+ '$home'}" >&2
    exit 1
fi

# Config is a flat env file so it stays readable and hand-editable. It carries
# the resolved path to datafile.py because tasks.py locates its storage engine
# relative to the path it was invoked as, and that lookup breaks through a symlink.
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

cd "$home"

# The registry tells SIANA which projects exist and where they live. Appending it
# to the system prompt makes that a guarantee rather than a read SIANA might skip.
#
# The fields are pinned rather than left to the default view, because `list` shows
# only the first few and would silently drop `worktree` - and a registry that looks
# complete while hiding a project's isolation policy is worse than no registry.
#
# A registry that cannot be read is a stop, not an empty registry. Injecting an
# error message here would leave SIANA believing the captain has no projects.
prompt=()
if [ -f "$home/schema-projects.yaml" ]; then
    if ! registry="$(datafile -f "$home/projects.jsonl" \
            list --fields handle,path,ship,orders,worktree 2>&1)"; then
        echo "the project registry at $home/projects.jsonl is not readable" >&2
        echo "$registry" >&2
        exit 1
    fi
    prompt=(--append-system-prompt "# The captain's projects ($home/projects.jsonl)
$registry")
fi

# Record which pane this session runs in, so `siana-watch` can wake SIANA when a
# minion reports. The pane id is the durable handle - herdr's labels are not unique
# and searching for a pi agent that looks about right could poke the wrong session -
# and it comes from the environment herdr sets, so it is never inferred.
#
# Outside herdr there is no pane and therefore nothing to poke. That is a working
# SIANA, just one the fleet cannot wake, so it is said plainly rather than refused.
session="$home/session"
if [ -n "${HERDR_PANE_ID:-}" ]; then
    printf '%s\n' "$HERDR_PANE_ID" > "$session"
    # The file must not outlive the session it names: a stale pane id is a poke sent
    # into whatever occupies that pane next. `siana-watch` also checks the pane still
    # holds pi, because a session killed outright never reaches this trap.
    #
    # Only this session's own id is cleared. A second session in the same home
    # overwrites the file, and removing whatever is there on the way out would
    # strip a still-running SIANA of the pointer the fleet wakes it through.
    release_session() {
        if [ "$(cat "$session" 2>/dev/null)" = "$HERDR_PANE_ID" ]; then
            rm -f "$session"
        fi
    }
    trap release_session EXIT
else
    # Nothing is removed here. With no pane of its own this session cannot tell a
    # stale pointer from one a running SIANA is reachable through, and `siana-watch`
    # already refuses on a pane that no longer holds pi.
    echo "not running under herdr: siana-watch cannot wake this session" >&2
fi

# --approve trusts this directory's project-local pi files. The captain created
# this directory by running init, so the consent is explicit rather than inferred.
pi --approve "${prompt[@]}" "$@"
