#!/usr/bin/env bash
# The captain's one interface. Opens an agent session in SIANA's home, where the
# fleet queue and SIANA's own instructions live.
set -euo pipefail

home="${SIANA_HOME:-$HOME/.siana}"
env_file="$home/siana.env"

if [ ! -f "$env_file" ]; then
    echo "SIANA is not initialized at $home" >&2
    echo "  run: just init${SIANA_HOME:+ '$home'}" >&2
    exit 1
fi

# Config is a flat env file so it stays readable and hand-editable. It carries
# the resolved path to datafile.py because tasks.py locates its storage engine
# relative to the path it was invoked as, and that lookup breaks through a symlink.
set -a
# shellcheck disable=SC1090
. "$env_file"
set +a

cd "$home"

# Which harness this session runs in. Both are told the same things in the same
# flag and differ only in how consent to this directory is given, so the choice is
# the captain's and is made per start rather than baked into the home.
#
# Resolved before anything else, and before the leader lock in particular: a
# refusal after the claim would take the session file and release it again, which
# a watcher reads as a SIANA that started and stopped.
harness="${SIANA_HARNESS:-}"
while [ $# -gt 0 ]; do
    case "$1" in
        --harness)
            [ $# -ge 2 ] || { echo "--harness needs a name: pi or claude" >&2; exit 1; }
            harness="$2"; shift 2 ;;
        --harness=*) harness="${1#--harness=}"; shift ;;
        *) break ;;
    esac
done

# The queue integration `just init` wrote for each harness. Checked rather than
# read out of siana.env, because a name recorded there is a claim about the home
# and these are the things themselves.
pi_settings="$home/.pi/settings.json"
claude_settings="$home/.claude/settings.json"

# No choice means whichever this home was installed for, pi first when it has
# both. `init` writes an integration for every harness it finds, so this is
# reading what the captain has rather than guessing between two working homes.
if [ -z "$harness" ]; then
    if [ -f "$pi_settings" ]; then harness=pi
    elif [ -f "$claude_settings" ]; then harness=claude
    else
        echo "no harness is installed in $home" >&2
        echo "  install pi or claude, then run \`just init\` in the distro" >&2
        exit 1
    fi
fi

# Named in a `case` rather than resolved by a function, because a function would
# have to report an unknown name from inside a command substitution, where `exit`
# leaves the subshell and the caller carries on with an empty path.
case "$harness" in
    pi)     settings="$pi_settings" ;;
    claude) settings="$claude_settings" ;;
    *)
        echo "unknown harness: $harness" >&2
        echo "  SIANA starts in pi or claude; nothing else is guessed" >&2
        exit 1 ;;
esac

# A harness whose integration was never installed opens a session with no fleet
# queue in front of it. That session looks exactly like a working SIANA, answers
# about the queue from nothing, and is the one failure this check exists for.
if [ ! -f "$settings" ]; then
    echo "$harness has no queue integration in $home" >&2
    echo "  install $harness, then run \`just init\` in the distro to write one" >&2
    exit 1
fi

command -v "$harness" >/dev/null || {
    echo "missing: $harness" >&2
    echo "  it is the harness this session was asked to start in" >&2
    exit 1
}

# The registry tells SIANA which projects exist and where they live. Appending it
# to the system prompt makes that a guarantee rather than a read SIANA might skip.
#
# The fields are pinned rather than left to the default view, because `list` shows
# only the first few and would silently drop `worktree`, `pipeline` and `automerge` -
# and a registry that looks complete while hiding a project's isolation policy, the
# fact that its ship tasks take a different verify, or that its accepted work merges
# without the captain, is worse than no registry.
#
# A registry that cannot be read is a stop, not an empty registry. Injecting an
# error message here would leave SIANA believing the captain has no projects.
#
# Both blocks build one string rather than passing the flag twice. claude's
# --append-system-prompt-file keeps only the last of two and silently drops the
# first (see siana-dispatch), and a fleet that assumed otherwise would start SIANA
# with half the context it believes it has. One flag cannot have that bug.
context=""
if [ -f "$home/schema-projects.yaml" ]; then
    stale=""
    if ! registry="$(datafile -f "$home/projects.jsonl" \
            list --fields handle,path,ship,pipeline,automerge,orders,worktree \
            2>&1)"; then
        # One drift is survivable, and exactly one: a home whose project contract
        # is older than `automerge`. Neither `init` nor `upgrade` rewrites a live
        # contract, because a field dropped from one makes every record still
        # carrying it unreadable, so every home installed before that field exists
        # in this state - and a distro that stopped starting on them would take the
        # fleet's only entry point away until a captain hand-edited a YAML file.
        #
        # Both halves have to hold before the field is dropped: `datafile` refused,
        # and the contract really does not declare it. A read that failed for any
        # other reason is the stop it has always been, and a contract that does
        # declare the field is never read without it - that read would hide a
        # standing merge grant from the one session that has to know about it.
        if ! grep -qE '^  automerge:' "$home/schema-projects.yaml" \
                && registry="$(datafile -f "$home/projects.jsonl" \
                    list --fields handle,path,ship,pipeline,orders,worktree \
                    2>&1)"; then
            stale=1
        else
            echo "the project registry at $home/projects.jsonl is not readable" >&2
            echo "$registry" >&2
            exit 1
        fi
    fi
    context="# The captain's projects ($home/projects.jsonl)
$registry"
    # Said to the captain, and said to SIANA, because they act on it differently.
    # The captain is the only one who can migrate the contract; SIANA is the one
    # that would otherwise try to set a field the store refuses, and read the
    # absent column as every project having been checked and found grantless.
    if [ -n "$stale" ]; then
        echo "stale    $home/schema-projects.yaml is older than \`automerge\`" >&2
        echo "         every project here is read as granting no merge, which is" >&2
        echo "         what they all were before that field existed" >&2
        echo "         to grant one, copy \`automerge\` into it from" >&2
        echo "         ${SIANA_DISTRO:-<the distro>}/template/schema-projects.yaml" >&2
        context="$context

This home's project contract is older than the \`automerge\` field, so no project
here can carry a merge grant, the column above is absent rather than empty, and
nothing merges without the captain. Migrating the contract is theirs: copy
\`automerge\` into $home/schema-projects.yaml from
${SIANA_DISTRO:-<the distro>}/template/schema-projects.yaml. Until they have, the
store refuses to record the field at all, so do not offer to set it."
    fi
fi

# What SIANA owes the captain and has not yet paid. Injected for the same reason the
# registry is: an obligation SIANA has to remember to go and look for is an
# obligation kept in memory, which is the whole thing this store replaces. A promise
# survives the session that made it only if the next session is told about it.
#
# Nothing owed is injected too, and is not skipped as an empty section: "owed
# nothing" is a fact SIANA needs, and its absence would read as never having asked.
#
# Unreadable is a stop, exactly as it is for the registry. Injecting the error text
# instead would leave SIANA believing it owes the captain nothing, which is the one
# wrong answer this store must never give.
if [ -f "$home/schema-obligations.yaml" ]; then
    if ! owed="$(siana-owe 2>&1)"; then
        echo "the obligations at $home/obligations.jsonl are not readable" >&2
        echo "$owed" >&2
        exit 1
    fi
    context="${context:+$context

}# What SIANA owes ($home/obligations.jsonl)
$owed

Record a new one with \`siana-owe promise|decision <text>\`, and retire it with
\`siana-owe close <id> --answer <text>\` when a durable event answers it. Never
close one from recollection, and never carry one in this conversation instead."
fi

prompt=()
[ -n "$context" ] && prompt=(--append-system-prompt "$context")

# One SIANA leads the fleet, and this file is what says which. A second would
# dispatch against the same queue while both believed they were the only one, so
# every task either could claim would be a race, and the captain would be talking to
# one of two agents with no way to tell which.
#
# It carries the pid, because that is what liveness can be asked about, and the pane
# id when there is one, because that is the pane `siana-watch` confirms this session
# is still in. The pane id comes from the environment herdr sets, never from
# searching for an agent that looks about right: herdr's labels are not unique, so a
# search would leave the watcher watching a pane this session was never in.
session="$home/session"

# Whether the recorded session is still running. A pid alone is not enough, because
# pids are reused, so the process wearing it must still be a siana. Anything else
# means the file outlived its session and is ours to take.
alive() {
    local pid
    pid="$(sed -n 's/^SIANA_PID=//p' "$session" 2>/dev/null)" || return 1
    [ -n "$pid" ] || return 1
    kill -0 "$pid" 2>/dev/null || return 1
    case "$(ps -p "$pid" -o command= 2>/dev/null)" in (*siana*) return 0 ;; esac
    return 1
}

# `ln` is atomic and refuses an existing destination, so two siana starting together
# cannot both win. Writing the content first and linking it into place also means the
# file is never visible half-written, which a reader would mistake for a dead session.
claim() {
    local tmp="$session.$$"
    {
        printf 'SIANA_PID=%s\n' "$$"
        [ -n "${HERDR_PANE_ID:-}" ] && printf 'SIANA_PANE=%s\n' "$HERDR_PANE_ID"
        # Which harness is in that pane. `siana-watch` reads it twice: it stops
        # when herdr reports a different agent there, because a pane this session
        # has left means nobody is reading the wakes it raises, and it refuses to
        # start at all against `claude`, which has no collision-free path into a
        # running session and so has no watcher. Herdr names the agent it detected,
        # so the watcher needs to know which name is SIANA's - and asking the home
        # would answer with what is installed rather than with what started.
        printf 'SIANA_HARNESS=%s\n' "$harness"
    } > "$tmp"
    if ln "$tmp" "$session" 2>/dev/null; then
        rm -f "$tmp"
        return 0
    fi
    rm -f "$tmp"
    return 1
}

if ! claim; then
    if alive; then
        pane="$(sed -n 's/^SIANA_PANE=//p' "$session" 2>/dev/null)"
        pid="$(sed -n 's/^SIANA_PID=//p' "$session" 2>/dev/null)"
        echo "SIANA is already leading the fleet (pid $pid)" >&2
        if [ -n "$pane" ]; then
            echo "  it is at pane $pane; attach with \`herdr agent attach $pane\`" >&2
        else
            echo "  it is running outside herdr, so it has no pane to attach to" >&2
        fi
        echo "  a second SIANA would race the first for every task in the queue" >&2
        exit 1
    fi
    # The recorded session is gone, so the file is a leftover from one that was
    # killed before its trap could run. Taking it over is the whole recovery.
    rm -f "$session"
    claim || { echo "cannot take $session; remove it and start again" >&2; exit 1; }
fi
trap 'rm -f "$session"' EXIT

[ -n "${HERDR_PANE_ID:-}" ] || \
    echo "not running under herdr: siana-watch cannot wake this session" >&2

# Started as a child and never `exec`ed, so the trap above still runs and the
# session file is released when the harness exits.
case "$harness" in
    # --approve trusts this directory's project-local pi files. The captain created
    # this directory by running init, so the consent is explicit rather than inferred.
    pi) pi --approve "${prompt[@]}" "$@" ;;
    # No consent flag. claude reads this directory's .claude/settings.json without
    # being asked, and the captain is sitting in front of this session: waiving its
    # permission prompts is a decision only they can make, so it is theirs to pass
    # through rather than one this command makes on their behalf. A minion's is
    # waived by `siana-dispatch` because nobody is there to answer one.
    claude) claude "${prompt[@]}" "$@" ;;
esac
