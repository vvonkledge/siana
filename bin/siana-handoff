#!/usr/bin/env python3
"""The copy a human reads on the merge request: validated here, assembled here.

A merge request used to be made out of the ship brief: the task's title became the
title, and two sections of the contract became the body. Both were written before
the work existed, by an agent briefing a minion, so what reached the forge said what
was asked for and could not say what was built, what it was checked with, or where a
reviewer's attention was worth most. The two merged that way read as instructions to
their own implementer.

So the copy is written by the minion that did the work, once the work is finished,
at `$SIANA_HOME/handoffs/<ship-task-id>.md`. That is judgment, and it stays with an
agent. What is exact stays here: the shape of that document, what may be missing
from it, and how its sections become one title and one body. Nothing in this file
reads a diff or asks a model, so publishing stays a deterministic assembly of prose
somebody already wrote and a second minion already accepted.

The head is what ties the two together. A handoff records the commit it describes,
and `siana-publish` refuses one that names anything other than the head QA accepted,
so a copy left behind by a later commit stops the publish instead of travelling with
work it does not describe.
"""

import argparse
import json
import os
import re
import shutil
import sys

# The five sections, in the order they are published in. They are a reader's
# questions in the order a reader asks them: what was wrong, what was done, how do
# I know, where do I look, and what did it cost.
#
# The list is exact, and an unknown heading is refused rather than dropped. A
# section an author wrote and nobody ever saw is worse than a refusal, because the
# refusal is the only thing that can tell them.
SECTIONS = ["Intent", "Solution", "Validation", "Hotspots", "Risks and boundaries"]

# What a merge request title may be. 72 is the git subject-line width this fleet
# already commits at, and a forge truncates past roughly that in every list view a
# reviewer scans, so a longer one is a title whose end nobody reads.
TITLE_LIMIT = 72

# The scaffolding markers, in the shape `siana-brief` writes and greps for. Read out
# of the preamble alone, because that is where the scaffold's are: `{TITLE}` and
# `{HEAD}` both sit above the first heading, and a section nobody filled in is caught
# by being empty once its guidance comment is stripped.
#
# Over the whole document it refused prose instead. This distro's templates are made
# of these tokens, so a handoff for work on one of them could not say what it
# changed: a `Hotspots` line naming `{SHIP_TASK}` was rejected as an unfilled
# placeholder, with no way to escape it, and the section exists for exactly that kind
# of concrete detail.
PLACEHOLDER = re.compile(r"\{[A-Z_]+\}")

# Where the home sits when nothing overrode it. Read by `main` and by the guard that
# refuses a path into it, so the default and the spellings of it cannot drift apart:
# a guard that did not know the default would let the README's own way of writing it
# through.
DEFAULT_HOME = "~/.siana"

# A fenced block opens here: the marker, then whatever info string follows it. Both
# markers, and any length from three up, because a longer run is how a fence quotes a
# shorter one and an example of this very document needs exactly that. Up to three
# leading spaces, which is what markdown itself reads as a fence rather than as
# indented code.
FENCE = re.compile(r"^ {0,3}(`{3,}|~{3,})(.*)$")


def die(message: str, *hints: str):
    print(f"error: {message}", file=sys.stderr)
    for hint in hints:
        print(f"  {hint}", file=sys.stderr)
    raise SystemExit(1)


def keyed(text: str, name: str):
    """Every indented `<name> <value>` line, as the brief records a branch on one.

    Indented and keyed so that prose about the title cannot be mistaken for the
    record of it, and returned as a list so that two of them is a refusal rather
    than a silent choice between them."""
    return re.findall(rf"^[ \t]+{name}[ \t]+(\S.*?)[ \t]*$", text, re.M)


def preamble(text: str) -> str:
    """Everything before the first `## `.

    The keyed lines are read from here and nowhere else, for the reason the brief
    reads its branch out of one section: a line inside `Solution` describing what
    the change titles something is prose, and a reader that scanned the whole file
    would publish it."""
    return text.split("\n## ", 1)[0]


def fence_opens(line: str):
    """The marker a fence opens with, or `None` for a line that opens none.

    A backtick fence's info string may not itself hold a backtick, which is markdown's
    own rule and the one that keeps a sentence beginning with a code span from being
    read as the start of a block nothing ever closes."""
    opens = FENCE.match(line)
    if not opens or (opens.group(1)[0] == "`" and "`" in opens.group(2)):
        return None
    return opens.group(1)


def fence_closes(marker: str, line: str) -> bool:
    """A line that closes a fence opened with `marker`.

    The same character and at least as many of them, with nothing else on the line.
    Both halves matter: a shorter run of the same marker is how a fenced example
    quotes another fence, and a run of the other marker is content."""
    return bool(re.fullmatch(rf" {{0,3}}{marker[0]}{{{len(marker)},}}[ \t]*", line))


def uncomment(line: str, in_comment: bool):
    """The line with its `<!-- ... -->` spans cut out, and whether one is still open.

    Returns `None` for a line that held nothing but comment, so a scaffold's guidance
    block disappears while a blank line an author typed survives it.

    The prose on either side of a comment is kept, both sides of it. Dropping the
    whole line was the inherited behaviour, and it deleted a sentence outright
    whenever an author wrote a note at the end of one, without saying so - the same
    choice this file refuses to make for a duplicate section, made silently.

    A comment is cut out as a whole word: the whitespace either side of one was
    holding it apart from the prose and goes with it, so what is left is joined by a
    single space. The whitespace the line opens with is not that whitespace, and it
    stays. Stripping it too kept every character of the prose and still rewrote the
    document: a note at the end of a nested bullet unindented the bullet, and one at
    the end of an indented example turned the example into a paragraph. Silently
    re-rendering the body is the same failure as silently dropping a line of it."""
    kept, rest, had, started = [], line, in_comment, in_comment
    while rest:
        if in_comment:
            _, closed, rest = rest.partition("-->")
            if not closed:
                break
            in_comment = False
            continue
        before, opened, rest = rest.partition("<!--")
        kept.append(before)
        if not opened:
            break
        had, in_comment = True, True
    if not had:
        return line, in_comment
    text = ""
    for i, piece in enumerate(kept):
        if i or started:
            # A comment was cut out just before this piece, so the gap it left closes
            # up: to one space against prose, to nothing against the line's indent.
            piece = piece.lstrip()
            if not piece:
                continue
            if text.strip():
                text = f"{text.rstrip()} {piece}"
                continue
        text += piece
    return text.rstrip() or None, in_comment


def sections(text: str, path: str = "the handoff"):
    """The `## ` sections, as (heading, body) in the order they appear.

    `<!-- ... -->` blocks are guidance to whoever fills the template in, so they are
    stripped rather than published. Duplicates are kept rather than folded: two
    `## Hotspots` is a document whose author lost track of one of them, and which of
    the two travels is not a choice this may make on their behalf.

    Nothing inside a fenced block is read at all: a `## Intent` in a quoted markdown
    example is what the example says and not a second section. That case is not
    exotic here - this fleet's work on its own distro is mostly the markdown other
    agents are briefed with - and reading one as a heading refused the document with
    a statement about it that was not true.

    A fence or a comment nobody closed is refused rather than run to the end of the
    document. Either one silently swallows every section after it, and a handoff
    missing four of its five sections is reported as the wrong fault entirely."""
    found, heading, body = [], None, []
    fence, in_comment = None, False
    for line in text.splitlines():
        if fence is not None:
            if heading is not None:
                body.append(line)
            if fence_closes(fence, line):
                fence = None
            continue
        if not in_comment:
            opens = fence_opens(line)
            if opens is not None:
                fence = opens
                if heading is not None:
                    body.append(line)
                continue
            if line.startswith("## "):
                if heading is not None:
                    found.append((heading, "\n".join(body).strip()))
                # Read through the same stripper as the body, so a heading carrying a
                # note is the section it names rather than an unknown one.
                named, in_comment = uncomment(line, False)
                heading, body = (named or "")[3:].strip(), []
                continue
        kept, in_comment = uncomment(line, in_comment)
        if heading is not None and kept is not None:
            body.append(kept)
    if fence is not None:
        die(f"{path} opens a fenced block that nothing closes",
            "everything after it reads as part of the example, so the sections",
            "below it are not sections and this document is not the one you wrote",
            f"close it with a line of {fence} on its own")
    if in_comment:
        die(f"{path} opens a `<!--` that nothing closes",
            "everything after it is a comment, so the prose and the sections below",
            "it would be dropped from the merge request without a word",
            "close it with `-->`")
    if heading is not None:
        found.append((heading, "\n".join(body).strip()))
    return found


def local_forms(home: str):
    """Every way the captain's home gets written, resolved and unresolved.

    The variable in both of the shapes a shell writes it in, the default directory in
    both of the ways a path under a home is written, and the resolved directory
    itself. They all name the same machine, so they are all equally unfollowable to a
    reviewer who is not on it."""
    tail = DEFAULT_HOME.lstrip("~")
    return (home, "$SIANA_HOME", "${SIANA_HOME}",
            DEFAULT_HOME, f"$HOME{tail}", f"${{HOME}}{tail}")


def refuse_local(path: str, where: str, text: str, home: str):
    """Refuse a path that only means something on the captain's machine.

    The home holds the queue, the briefs and every QA report, so a path into it is
    either a pointer nobody outside this machine can follow or a quote from something
    written for SIANA alone. Neither is review material.

    Every spelling of it, because a minion writes the resolved path as often as the
    variable it read it from, and neither of those is the only way it gets written.
    The list was once the resolved path and `$SIANA_HOME` alone, and what walked past
    it was `~/.siana`, which is how this project's own README spells the directory,
    and `${SIANA_HOME}`, which is how a shell script writes the variable. A guard that
    catches one spelling of a path is a guard whose author believes it catches the
    path.

    Applied to the title as well as to the sections. The title is the single most
    visible line on the page, so it is the last place a leak should have been allowed
    to go unread.

    The form that matched is named and the line carrying it is not: what is around it
    is the author's prose, and quoting it back would print the captain-local material
    this exists to keep from travelling."""
    for local in local_forms(home):
        if local in text:
            die(f"{where} of {path} names {local}",
                "that path is the captain's machine and nowhere else, and what",
                "it holds is written for this fleet rather than for a reviewer",
                "say where it is in words instead: a reader who cannot follow the",
                "pointer is better served by the sentence than by the path")


def read(path: str, task_id: str, home: str, head: str = None):
    """One handoff, checked against every rule a script can state, as (title, body).

    Every refusal here is a way the forge could receive copy that does not describe
    this work: absent, half-written, describing a commit that is no longer the head,
    or carrying a path that only exists on the captain's machine."""
    try:
        with open(path) as fh:
            text = fh.read()
    except OSError:
        die(f"no handoff for {task_id} at {path}",
            "it is the title and the body a human reads on the merge request, and",
            "the minion that did the work writes it before the work is accepted",
            f"  siana-handoff {task_id} --scaffold   # then fill it in")

    unfilled = PLACEHOLDER.search(preamble(text))
    if unfilled:
        die(f"{path} still carries {unfilled.group()}",
            "a merge request describing the work as `{TITLE}` looks like a",
            "description and is not one")

    titles = keyed(preamble(text), "title")
    if not titles:
        die(f"{path} records no title",
            "the preamble needs an indented line of exactly:",
            "    title  <what the merge request is called>")
    if len(titles) > 1:
        die(f"{path} records more than one title: {', '.join(titles)}",
            "which of them names the work is not a choice a script may make")
    title = titles[0]
    if len(title) > TITLE_LIMIT:
        die(f"the title in {path} is {len(title)} characters, and {TITLE_LIMIT} is "
            "the limit",
            "a forge truncates past roughly that wherever a reviewer scans a list",
            f"  {title}")
    if title == task_id:
        die(f"the title in {path} is the task id",
            "a task id names a row in a queue nobody outside this fleet can read;",
            "the title says what changed and why it matters")
    refuse_local(path, "the title", title, home)

    heads = keyed(preamble(text), "head")
    if not heads:
        die(f"{path} records no head",
            "the head is the commit this copy describes, and without it nothing",
            "can tell a current handoff from one a later commit left behind",
            "the preamble needs an indented line of exactly:",
            "    head  <full commit sha>")
    if len(heads) > 1:
        die(f"{path} records more than one head: {', '.join(heads)}",
            "a copy describes one commit, and which one is not a script's to pick")
    if not re.fullmatch(r"[0-9a-f]{40}", heads[0]):
        die(f"{path} records the head as {heads[0]!r}",
            "it has to be the full sha, because an abbreviation is a prefix and a",
            "prefix cannot be compared for equality with the head that was accepted",
            "  head  $(git rev-parse HEAD)")
    if head is not None and heads[0] != head:
        die(f"the handoff for {task_id} describes {heads[0][:12]}, and the branch is "
            f"at {head[:12]}",
            "so this copy was written before the commit it would be published",
            "against, and it cannot say what that commit does",
            "rewrite it against the head that was accepted:",
            f"  siana-handoff {task_id} --head {head}")

    found = sections(text, path)
    headings = [heading for heading, _ in found]
    unknown = [h for h in headings if h not in SECTIONS]
    if unknown:
        die(f"{path} has sections nothing publishes: {', '.join(unknown)}",
            "the body is these five, in this order, and nothing else travels:",
            f"  {', '.join(SECTIONS)}",
            "a section written and never read is worse than one refused")
    missing = [h for h in SECTIONS if h not in headings]
    if missing:
        die(f"{path} has no `## {missing[0]}` section",
            "the body is these five, and each of them is a question the reviewer",
            f"asks: {', '.join(SECTIONS)}")
    repeated = sorted({h for h in headings if headings.count(h) > 1})
    if repeated:
        die(f"{path} has more than one `## {repeated[0]}` section",
            "which of them travels is not a choice a script may make for its author")

    body = dict(found)
    for heading in SECTIONS:
        if not body[heading]:
            die(f"the `## {heading}` section of {path} is empty",
                "a heading with nothing under it answers the question by pretending",
                "it was asked; write the section or say why it does not apply")
        refuse_local(path, f"the `## {heading}` section", body[heading], home)
    return title, body


def assemble(body: dict, ship_id: str = None, qa_id: str = None) -> str:
    """The five sections as one document, in the published order.

    `qa_id` is what a script may add and an author may not: it is a fact about the
    queue rather than a judgment about the work, and the minion that wrote the copy
    finished before any of it happened. Without it this is the author's own copy,
    which is what they see while they are still writing it."""
    out = []
    for heading in SECTIONS:
        text = body[heading]
        if heading == "Validation" and qa_id:
            text += ("\n\nIndependently reviewed and accepted by a second agent "
                     "that did not write it.")
        out += [f"## {heading}", "", text, ""]
    if qa_id:
        out += ["---", f"Shipped by `{ship_id}`, accepted by `{qa_id}`."]
    return "\n".join(out).strip() + "\n"


def scaffold(home: str, path: str, task_id: str):
    template = os.path.join(home, "handoff.md")
    if not os.path.isfile(template):
        die(f"no handoff template at {template}",
            "SIANA owns its home copy and can evolve it",
            "run `just init` in the distro to lay one down")
    if os.path.exists(path):
        die(f"{task_id} already has a handoff at {path}",
            "a handoff is rewritten by editing it, never by scaffolding over it:",
            "a QA minion may already have read this one")
    os.makedirs(os.path.dirname(path), exist_ok=True)
    shutil.copy(template, path)
    print(f"scaffolded  {path}")
    print("  fill    the title, the head, and every section")


def main() -> None:
    ap = argparse.ArgumentParser(
        description="Validate and assemble the copy a human reads on the merge "
                    "request for a ship task.")
    ap.add_argument("task_id", help="the ship task whose work this describes")
    ap.add_argument("--scaffold", action="store_true",
                    help="write the template to fill in, and check nothing")
    ap.add_argument("--head", metavar="SHA",
                    help="refuse unless the handoff describes this commit")
    ap.add_argument("--accepted-by", metavar="QA-TASK",
                    help="the QA task that accepted the work; adds the independent "
                         "review to the body, which is not the author's to write")
    ap.add_argument("--json", action="store_true",
                    help="print the title and body as one object, for a caller")
    args = ap.parse_args()

    home = os.environ.get("SIANA_HOME", os.path.expanduser(DEFAULT_HOME))
    path = os.path.join(home, "handoffs", f"{args.task_id}.md")

    if args.scaffold:
        scaffold(home, path, args.task_id)
        return

    title, body = read(path, args.task_id, home, args.head)
    text = assemble(body, args.task_id, args.accepted_by)

    if args.json:
        json.dump({"title": title, "body": text}, sys.stdout)
        return
    print(f"title:  {title}")
    print("body:")
    for line in text.splitlines():
        print(f"  {line}")


if __name__ == "__main__":
    main()
